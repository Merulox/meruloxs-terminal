---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
	title: string;
	description?: string;
	homepage?: boolean;
	navItems?: { href: string; label: string }[];
	homeHref?: string;
	noindex?: boolean;
	wide?: boolean;
}

const {
	title,
	description = ">merulox's terminal",
	homepage = false,
	navItems: customNavItems,
	homeHref = "/",
	noindex = false,
	wide = false,
} = Astro.props;

const pathname = Astro.url.pathname;
const canonicalUrl = new URL(pathname, Astro.site ?? Astro.url.origin);

const defaultNavItems = [
	{ href: "/projects", label: "projects" },
	{ href: "/thinking", label: "writing" },
	{ href: "/music", label: "music" },
	{ href: "/reading", label: "reading" },
	{ href: "/links", label: "links" },
	{ href: "/log", label: "log" },
];

const navItems = customNavItems ?? defaultNavItems;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link
			rel="preload"
			href="/fonts/vt323-latin.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<ClientRouter />
	</head>
	<body>
		<audio id="bgm-audio" preload="auto" autoplay muted transition:persist></audio>
		<header class="home-statusbar">
			<div class="home-statusbar-left">
				<span class="home-brand">[navi]</span>
				<span class="home-host">merulox</span>
				<span class="home-tagline">cyberia's schemer boy</span>
			</div>
			<div class="home-statusbar-center">
				<button
					class="bgm-toggle"
					id="bgm-toggle"
					type="button"
					aria-label="Play background music"
					aria-pressed="false"
					hidden
				>
					<span class="bgm-icon" aria-hidden="true">▶</span>
				</button>
				<input
					class="bgm-volume"
					id="bgm-volume"
					type="range"
					min="0"
					max="1"
					step="0.01"
					aria-label="Background music volume"
					hidden
				/>
				<span class="bgm-track" id="bgm-track" hidden></span>
			</div>
			<div class="home-statusbar-right">
				<span class="home-now-playing" id="now-playing" hidden></span>
				<span class="home-clock" id="home-clock"></span>
				<span class="home-visits" id="home-visits" hidden></span>
				<button
					class="home-shortcuts-btn"
					id="shortcuts-btn"
					type="button"
					aria-haspopup="dialog"
				>
					? shortcuts
				</button>
			</div>
		</header>
		<dialog class="shortcuts-dialog" id="shortcuts-dialog">
			<div class="shortcuts-dialog-head">
				<span>keyboard shortcuts</span>
				<button id="shortcuts-close" type="button" aria-label="Close">×</button>
			</div>
			<dl class="shortcuts-list">
				<dt><kbd>j</kbd> <kbd>k</kbd> / <kbd><span class="glyph-fallback">↓</span></kbd> <kbd><span class="glyph-fallback">↑</span></kbd></dt>
				<dd>move through the list / rows</dd>
				<dt><kbd>h</kbd> <kbd>l</kbd> / <kbd><span class="glyph-fallback">←</span></kbd> <kbd><span class="glyph-fallback">→</span></kbd></dt>
				<dd>move across the top nav</dd>
				<dt><kbd>Enter</kbd></dt>
				<dd>open the highlighted item</dd>
				<dt><kbd>?</kbd></dt>
				<dd>toggle this panel</dd>
				<dt><kbd>Esc</kbd></dt>
				<dd>close</dd>
			</dl>
		</dialog>
		{
			homepage ? (
				<slot />
			) : (
				<div class:list={["site-shell", { "site-shell--wide": wide }]}>
					<div class="site-pane">
						<header class="site-header">
							<a class="site-name kbd-item" href={homeHref}>
								MERULOX
							</a>
							<nav class="site-nav" aria-label="Primary navigation">
								{navItems.map((item) => {
									const itemPath = item.href.replace(/\/$/, "");
									const currentPath = pathname.replace(/\/$/, "");
									const isActive = currentPath === itemPath;
									return (
										<a
											href={item.href}
											class="kbd-item"
											aria-current={isActive ? "page" : undefined}
										>
											<span class="sel-arrow" aria-hidden="true">&gt;</span>
											{item.label}
										</a>
									);
								})}
							</nav>
						</header>
						<main>
							<slot />
						</main>
					</div>
				</div>
			)
		}
		<script>
			let navAbort: AbortController | null = null;
			function initKeyboardNav() {
				navAbort?.abort();
				navAbort = new AbortController();
				const { signal } = navAbort;
				const navEls = Array.from(
					document.querySelectorAll<HTMLElement>(".site-name, .site-nav a"),
				);
				if (!navEls.length) return;

				const allListEls = Array.from(
					document.querySelectorAll<HTMLElement>(".list-item"),
				);
				const visibleListEls = () =>
					allListEls.filter((el) => !el.closest<HTMLElement>("[hidden]"));
				let listEls = visibleListEls();
				const rowGroups = Array.from(
					document.querySelectorAll<HTMLElement>(".kbd-row"),
				);

				const CUR = "kbd-cursor";
				const paint = (els: HTMLElement[], idx: number) =>
					els.forEach((el, i) => el.classList.toggle(CUR, i === idx));
				const clear = (els: HTMLElement[]) =>
					els.forEach((el) => el.classList.remove(CUR));
				const focusItem = (el: HTMLElement) => {
					if (document.activeElement === el) return;
					el.focus({ preventScroll: true });
				};

				const navStart = Math.max(
					0,
					navEls.findIndex((el) => el.getAttribute("aria-current") === "page"),
				);
				const skipTarget = (e: KeyboardEvent) => {
					// Let browser/OS shortcuts and unmanaged native controls behave normally.
					if (e.ctrlKey || e.metaKey || e.altKey) return true;
					const target = e.target as HTMLElement;
					const interactive = target.closest<HTMLElement>(
						'a, button, input, textarea, select, summary, [contenteditable="true"]',
					);
					return Boolean(
						interactive &&
							!navEls.includes(interactive) &&
							!listEls.includes(interactive) &&
							!interactive.classList.contains("row-item"),
					);
				};

				if (listEls.length) {
					// ── Two independent cursors (projects) ──
					//   Left/Right → nav,  Up/Down → project list
					let navIdx = navStart;
					let listIdx = 0;
					let last: "nav" | "list" = "list";
					const refreshListEls = (reset = false) => {
						const next = visibleListEls();
						if (!next.length) return;
						clear(allListEls);
						listEls = next;
						listIdx = reset ? 0 : Math.min(listIdx, listEls.length - 1);
						paint(listEls, listIdx);
					};
					paint(navEls, navIdx);
					paint(listEls, listIdx);

					document.addEventListener(
						"focusin",
						(e) => {
							const t = e.target as HTMLElement;
							const n = navEls.indexOf(t);
							if (n !== -1) { navIdx = n; paint(navEls, n); last = "nav"; return; }
							const l = listEls.indexOf(t);
							if (l !== -1) { listIdx = l; paint(listEls, l); last = "list"; }
						},
						{ signal },
					);

					document.addEventListener(
						"archive-panel-change",
						() => {
							refreshListEls(true);
						},
						{ signal },
					);

					document.addEventListener("keydown", (e) => {
						if (skipTarget(e)) return;
						refreshListEls();
						switch (e.key) {
							case "ArrowLeft": case "h":
								e.preventDefault();
								navIdx = (navIdx - 1 + navEls.length) % navEls.length;
								paint(navEls, navIdx);
								focusItem(navEls[navIdx]);
								last = "nav"; break;
							case "ArrowRight": case "l":
								e.preventDefault();
								navIdx = (navIdx + 1) % navEls.length;
								paint(navEls, navIdx);
								focusItem(navEls[navIdx]);
								last = "nav"; break;
							case "ArrowUp": case "k":
								e.preventDefault();
								listIdx = (listIdx - 1 + listEls.length) % listEls.length;
								paint(listEls, listIdx);
								focusItem(listEls[listIdx]);
								listEls[listIdx].scrollIntoView({ block: "nearest" }); last = "list"; break;
							case "ArrowDown": case "j":
								e.preventDefault();
								listIdx = (listIdx + 1) % listEls.length;
								paint(listEls, listIdx);
								focusItem(listEls[listIdx]);
								listEls[listIdx].scrollIntoView({ block: "nearest" }); last = "list"; break;
							case "Enter": {
								const a = document.activeElement as HTMLElement;
								if (navEls.includes(a) || listEls.includes(a)) return;
								e.preventDefault();
								(last === "list" ? listEls[listIdx] : navEls[navIdx]).click();
								break;
							}
						}
					}, { signal });
					return;
				}

				// ── Single row/col cursor (music, now, writing, projects) ──
				//   Up/Down → between rows (nav, then each .kbd-row)
				//   Left/Right → within the current row
				//   .kbd-row groups inside a currently-hidden panel are skipped —
				//   rebuilt on every keypress so switching panels (archive-panel-change)
				//   reflects immediately without a stale row list.
				const buildRows = (): HTMLElement[][] =>
					[
						navEls,
						...rowGroups
							.filter((g) => !g.closest<HTMLElement>("[hidden]"))
							.map((g) => Array.from(g.querySelectorAll<HTMLElement>(".row-item"))),
					].filter((row) => row.length);

				let rows = buildRows();
				let r = 0;
				let c = navStart;
				const paintCell = () => {
					rows.forEach(clear);
					paint(rows[r], c);
				};
				const scrollIntoFullView = (el: HTMLElement) => {
					const margin = 24;
					const rect = el.getBoundingClientRect();
					const visualViewport = window.visualViewport;
					const viewportHeight = visualViewport?.height ?? window.innerHeight;
					const viewportOffsetTop = visualViewport?.offsetTop ?? 0;
					const absoluteTop = window.scrollY + viewportOffsetTop + rect.top;
					const absoluteBottom = absoluteTop + rect.height;
					const visibleTop = window.scrollY + viewportOffsetTop + margin;
					const visibleBottom = window.scrollY + viewportOffsetTop + viewportHeight - margin;
					const maxTop = document.documentElement.scrollHeight - viewportHeight;
					let top = window.scrollY;

					if (rect.height + margin * 2 <= viewportHeight) {
						if (absoluteBottom > visibleBottom) {
							top = absoluteBottom + margin - viewportOffsetTop - viewportHeight;
						}
						if (absoluteTop < visibleTop) {
							top = absoluteTop - margin - viewportOffsetTop;
						}
					} else {
						top = absoluteTop - margin - viewportOffsetTop;
					}

					window.scrollTo({
						top: Math.max(0, Math.min(top, maxTop)),
						behavior: "smooth",
					});
				};
				const scrollToPreview = (el: HTMLElement) => {
					const visualViewport = window.visualViewport;
					const viewportHeight = visualViewport?.height ?? window.innerHeight;
					const viewportOffsetTop = visualViewport?.offsetTop ?? 0;
					const previewHeight = Math.min(180, Math.max(120, viewportHeight * 0.16));
					const absoluteTop = window.scrollY + viewportOffsetTop + el.getBoundingClientRect().top;
					const maxTop = document.documentElement.scrollHeight - viewportHeight;

					window.scrollTo({
						top: Math.max(0, Math.min(
							absoluteTop - viewportOffsetTop - viewportHeight + previewHeight,
							maxTop,
						)),
						behavior: "smooth",
					});
				};
				const scrollForRow = () => {
					if (r === 0) {
						window.scrollTo({ top: 0, behavior: "smooth" });
						return;
					}

					const bar = rows[r][c].closest<HTMLElement>(".kbd-row");
					const scrollPreview = bar?.dataset.scrollPreview;
					if (scrollPreview) {
						const preview = document.querySelector<HTMLElement>(scrollPreview);
						if (preview) {
							scrollToPreview(preview);
							return;
						}
					}
					const scrollTarget = bar?.dataset.scrollTarget;
					if (scrollTarget) {
						const target = document.querySelector<HTMLElement>(scrollTarget);
						if (target) scrollIntoFullView(target);
					} else if (r === rows.length - 1) {
						// Last row → reveal everything below it (e.g. the last.fm link)
						window.scrollTo({ top: document.body.scrollHeight, behavior: "smooth" });
					} else {
						(bar || rows[r][c]).scrollIntoView({ block: "center", behavior: "smooth" });
					}
				};
				paintCell();

				const refreshRows = (reset = false) => {
					const next = buildRows();
					if (!next.length) return;
					rows = next;
					r = reset ? 0 : Math.min(r, rows.length - 1);
					c = Math.min(c, rows[r].length - 1);
				};
				document.addEventListener("archive-panel-change", () => {
					refreshRows();
					paintCell();
				}, { signal });

				document.addEventListener("focusin", (e) => {
					const t = e.target as HTMLElement;
					for (let ri = 0; ri < rows.length; ri++) {
						const ci = rows[ri].indexOf(t);
						if (ci !== -1) { r = ri; c = ci; paintCell(); return; }
					}
				}, { signal });

				document.addEventListener("keydown", (e) => {
					if (skipTarget(e)) return;
					refreshRows();
					switch (e.key) {
						case "ArrowUp": case "k":
							if (rows.length > 1) {
								e.preventDefault();
								r = (r - 1 + rows.length) % rows.length;
								c = Math.min(c, rows[r].length - 1);
								paintCell();
								focusItem(rows[r][c]);
								scrollForRow();
							}
							break;
						case "ArrowDown": case "j":
							if (rows.length > 1) {
								e.preventDefault();
								r = (r + 1) % rows.length;
								c = Math.min(c, rows[r].length - 1);
								paintCell();
								focusItem(rows[r][c]);
								scrollForRow();
							}
							break;
						case "ArrowLeft": case "h":
							e.preventDefault();
							c = (c - 1 + rows[r].length) % rows[r].length;
							paintCell();
							focusItem(rows[r][c]); break;
						case "ArrowRight": case "l":
							e.preventDefault();
							c = (c + 1) % rows[r].length;
							paintCell();
							focusItem(rows[r][c]); break;
						case "Enter": {
							const a = document.activeElement as HTMLElement;
							if (rows.some((row) => row.includes(a))) return;
							e.preventDefault();
							rows[r][c].click();
							break;
						}
				}
				}, { signal });
			}
			// astro:page-load fires on the initial hard load as well as every
			// subsequent client-side transition, so a single listener covers
			// both — calling initKeyboardNav() directly here too would race
			// it on first load.
			document.addEventListener("astro:page-load", initKeyboardNav);
		</script>
		<script>
			// Bumped (v2) because gym-class.mp3's timeline shifted 15s when its
			// source got a start offset — any saved currentTime from before
			// that change would point at the wrong moment in the new file.
			const BGM_STATE_KEY = "merulox-bgm-state-v2";
			const BGM_VOLUME_KEY = "merulox-bgm-volume";
			const BGM_VOLUME_SCALE = 0.5;
			type BgmTrack = { slug: string; title: string; artist: string; src: string };
			type BgmState = {
				order: string[];
				index: number;
				currentTime: number;
				playing: boolean;
			};
			type BgmHandle = {
				state: BgmState;
				bySlug: Map<string, BgmTrack>;
				rawVolume: number;
				renderTrack: () => void;
				syncToggleUi: () => void;
				els: {
					toggle: HTMLButtonElement;
					track: HTMLElement | null;
					volume: HTMLInputElement | null;
				};
			};
			function shuffledSlugs(tracks: BgmTrack[]): string[] {
				const slugs = tracks.map((t) => t.slug);
				for (let i = slugs.length - 1; i > 0; i--) {
					const j = Math.floor(Math.random() * (i + 1));
					[slugs[i], slugs[j]] = [slugs[j], slugs[i]];
				}
				return slugs;
			}
			function readBgmState(validSlugs: string[]): BgmState | null {
				try {
					const raw = sessionStorage.getItem(BGM_STATE_KEY);
					if (!raw) return null;
					const parsed = JSON.parse(raw) as BgmState;
					if (
						!Array.isArray(parsed.order) ||
						parsed.order.length !== validSlugs.length ||
						!parsed.order.every((s) => validSlugs.includes(s))
					) {
						return null;
					}
					return parsed;
				} catch {
					return null;
				}
			}
			function writeBgmState(state: BgmState) {
				try {
					sessionStorage.setItem(BGM_STATE_KEY, JSON.stringify(state));
				} catch {
					/* best effort */
				}
			}

			// Background music: small curated playlist. The <audio> element is
			// marked transition:persist, so it survives client-side navigation
			// untouched — this function detects that case (a handle already
			// stashed on the element) and only rebinds this page's fresh
			// toggle/volume/track controls to the still-playing element,
			// instead of re-picking a track or touching playback.
			async function initBgm(signal: AbortSignal) {
				const bgmToggle = document.getElementById(
					"bgm-toggle",
				) as HTMLButtonElement | null;
				const bgmTrackEl = document.getElementById("bgm-track");
				const bgmVolumeEl = document.getElementById(
					"bgm-volume",
				) as HTMLInputElement | null;
				if (!bgmToggle) return;

				const audio = document.getElementById(
					"bgm-audio",
				) as HTMLAudioElement | null;
				if (!audio) return;

				const host = audio as unknown as {
					_bgm?: BgmHandle;
					_bgmInit?: Promise<void>;
				};

				const bindResumeUi = (existing: BgmHandle) => {
					existing.els = { toggle: bgmToggle, track: bgmTrackEl, volume: bgmVolumeEl };
					existing.renderTrack();
					existing.syncToggleUi();
					bgmToggle.hidden = false;
					if (bgmVolumeEl) {
						bgmVolumeEl.hidden = false;
						bgmVolumeEl.value = String(existing.rawVolume);
						bgmVolumeEl.addEventListener(
							"input",
							() => {
								const raw = Number(bgmVolumeEl.value);
								existing.rawVolume = raw;
								audio.volume = raw * BGM_VOLUME_SCALE;
								try {
									localStorage.setItem(BGM_VOLUME_KEY, String(raw));
								} catch {
									/* best effort */
								}
							},
							{ signal },
						);
					}
					bgmToggle.addEventListener(
						"click",
						() => {
							audio.muted = false;
							if (audio.paused) audio.play().catch(() => {});
							else audio.pause();
						},
						{ signal },
					);
				};

				if (host._bgm) {
					bindResumeUi(host._bgm);
					return;
				}

				if (host._bgmInit) {
					// A cold start from an overlapping navigation is already in
					// flight (this page loaded while the manifest fetch kicked
					// off by a previous page's initBgm() was still pending) —
					// wait for it instead of starting a second, redundant cold
					// start, which would double-attach the play/pause/ended
					// listeners and the position-save interval on the same
					// persisted <audio> element.
					await host._bgmInit;
					if (host._bgm) bindResumeUi(host._bgm);
					return;
				}

				// Stash the in-flight promise synchronously, before any await,
				// so any initBgm() call that arrives while the manifest fetch
				// below is still pending takes the branch above instead of
				// racing this one.
				host._bgmInit = (async () => {
				try {
					let tracks: BgmTrack[] = [];
					try {
						const res = await fetch("/audio/manifest.json");
						if (!res.ok) return;
						tracks = await res.json();
					} catch {
						return;
					}
					if (!tracks.length) return;

					const bySlug = new Map(tracks.map((t) => [t.slug, t]));
					const slugs = tracks.map((t) => t.slug);
					const state: BgmState = readBgmState(slugs) ?? {
						order: shuffledSlugs(tracks),
						index: 0,
						currentTime: 0,
						playing: true,
					};
					writeBgmState(state);

					const storedVolume = localStorage.getItem(BGM_VOLUME_KEY);
					const savedVolume = storedVolume === null ? NaN : Number(storedVolume);
					const rawVolume =
						Number.isFinite(savedVolume) && savedVolume >= 0 && savedVolume <= 1
							? savedVolume
							: 0.15;
					audio.volume = rawVolume * BGM_VOLUME_SCALE;

					const handle: BgmHandle = {
						state,
						bySlug,
						rawVolume,
						renderTrack: () => {
							const track = handle.bySlug.get(handle.state.order[handle.state.index]);
							const el = handle.els.track;
							if (!track || !el) return;
							el.textContent = track.artist
								? `${track.title} — ${track.artist}`
								: track.title;
							el.hidden = false;
						},
						syncToggleUi: () => {
							const btn = handle.els.toggle;
							if (!btn) return;
							const playing = !audio.paused;
							btn.setAttribute("aria-pressed", playing ? "true" : "false");
							btn.setAttribute(
								"aria-label",
								playing ? "Pause background music" : "Play background music",
							);
							const icon = btn.querySelector(".bgm-icon");
							if (icon) icon.textContent = playing ? "❚❚" : "▶";
						},
						els: { toggle: bgmToggle, track: bgmTrackEl, volume: bgmVolumeEl },
					};
					host._bgm = handle;

					function loadTrack(resumeTime: number) {
						const track = handle.bySlug.get(handle.state.order[handle.state.index]);
						if (!track) return;
						audio!.src = track.src;
						const seek = () => {
							if (resumeTime > 0 && resumeTime < (audio!.duration || Infinity)) {
								audio!.currentTime = resumeTime;
							}
							audio!.removeEventListener("loadedmetadata", seek);
						};
						audio!.addEventListener("loadedmetadata", seek);
						handle.renderTrack();
					}

					loadTrack(state.currentTime);
					bgmToggle.hidden = false;
					if (bgmVolumeEl) {
						bgmVolumeEl.hidden = false;
						bgmVolumeEl.value = String(rawVolume);
					}

					// The <audio autoplay muted> element (declarative, in the HTML)
					// gets the lenient "muted autoplay is always allowed" policy
					// that a plain `new Audio(); audio.play()` call does not reliably
					// get in every browser. If the session wants playback, let the
					// browser's native autoplay take it from here; if not (user had
					// explicitly paused before leaving), cancel it immediately so
					// the autoplay attribute doesn't override that choice.
					audio!.muted = true;
					if (!state.playing) audio!.pause();
					handle.syncToggleUi();

					const unmuteEvents = ["pointerdown", "keydown", "touchstart", "wheel"];
					function unmuteOnFirstInteraction() {
						if (audio!.muted) audio!.muted = false;
						if (audio!.paused && state.playing) audio!.play().catch(() => {});
						unmuteEvents.forEach((ev) =>
							document.removeEventListener(ev, unmuteOnFirstInteraction),
						);
					}
					unmuteEvents.forEach((ev) =>
						document.addEventListener(ev, unmuteOnFirstInteraction, {
							passive: true,
						}),
					);

					bgmToggle.addEventListener("click", () => {
						audio!.muted = false;
						if (audio!.paused) audio!.play().catch(() => {});
						else audio!.pause();
					});
					if (bgmVolumeEl) {
						bgmVolumeEl.addEventListener("input", () => {
							const raw = Number(handle.els.volume?.value ?? "0");
							handle.rawVolume = raw;
							audio!.volume = raw * BGM_VOLUME_SCALE;
							try {
								localStorage.setItem(BGM_VOLUME_KEY, String(raw));
							} catch {
								/* best effort */
							}
						});
					}
					audio!.addEventListener("play", () => {
						handle.state.playing = true;
						writeBgmState(handle.state);
						handle.syncToggleUi();
					});
					audio!.addEventListener("pause", () => {
						handle.state.playing = false;
						writeBgmState(handle.state);
						handle.syncToggleUi();
					});
					audio!.addEventListener("ended", () => {
						handle.state.index = (handle.state.index + 1) % handle.state.order.length;
						handle.state.currentTime = 0;
						writeBgmState(handle.state);
						loadTrack(0);
						audio!.play().catch(() => {});
					});
					setInterval(() => {
						if (!audio!.paused) {
							handle.state.currentTime = audio!.currentTime;
							writeBgmState(handle.state);
						}
					}, 3_000);
				} finally {
					delete host._bgmInit;
				}
				})();
				await host._bgmInit;
			}

			let headerAbort: AbortController | null = null;
			let clockInterval: ReturnType<typeof setInterval> | undefined;
			let npInterval: ReturnType<typeof setInterval> | undefined;

			function initHeaderWidgets() {
				headerAbort?.abort();
				headerAbort = new AbortController();
				const { signal } = headerAbort;

				const LFM_API_KEY = "9fdb2ae95fb0b95470334c260149c3cb";
				const LFM_USER = "merulox";
				const EASTERN = "America/New_York";

				// ── Clock ──
				const clockEl = document.getElementById("home-clock");
				const clockFmt = new Intl.DateTimeFormat("en-US", {
					timeZone: EASTERN,
					month: "short",
					day: "2-digit",
					hour: "2-digit",
					minute: "2-digit",
					second: "2-digit",
					hour12: false,
				});
				function tickClock() {
					if (clockEl) clockEl.textContent = clockFmt.format(new Date());
				}
				tickClock();
				clearInterval(clockInterval);
				clockInterval = setInterval(tickClock, 1_000);

				// ── Now playing (last.fm), cached across page navigations ──
				const nowPlayingEl = document.getElementById("now-playing");
				const NP_CACHE_KEY = "merulox-np-cache";
				const NP_CACHE_MS = 120_000; // 2 minutes

				function applyNowPlaying(entry: { hidden: boolean; html?: string }) {
					if (!nowPlayingEl) return;
					if (!entry || entry.hidden) {
						nowPlayingEl.hidden = true;
						return;
					}
					nowPlayingEl.innerHTML = entry.html ?? "";
					nowPlayingEl.hidden = false;
				}
				function readNpCache(): { hidden: boolean; html?: string } | null {
					try {
						const raw = sessionStorage.getItem(NP_CACHE_KEY);
						if (!raw) return null;
						const parsed = JSON.parse(raw);
						if (Date.now() - parsed.ts > NP_CACHE_MS) return null;
						return parsed;
					} catch {
						return null; // private mode / storage disabled — just skip caching
					}
				}
				function writeNpCache(entry: { hidden: boolean; html?: string }) {
					try {
						sessionStorage.setItem(NP_CACHE_KEY, JSON.stringify({ ...entry, ts: Date.now() }));
					} catch {
						/* ignore */
					}
				}
				async function loadNowPlaying(opts: { force?: boolean } = {}) {
					if (!nowPlayingEl) return;
					if (!opts.force) {
						const cached = readNpCache();
						if (cached) {
							applyNowPlaying(cached);
							return;
						}
					}
					try {
						const res = await fetch(
							`https://ws.audioscrobbler.com/2.0/?method=user.getrecenttracks&user=${LFM_USER}&api_key=${LFM_API_KEY}&limit=1&format=json`,
						);
						const data = await res.json();
						const track = data.recenttracks?.track?.[0];
						const isNowPlaying = track?.["@attr"]?.nowplaying === "true";
						const entry = isNowPlaying && track
							? {
									hidden: false,
									html: `<span class="np-note">♪</span> ${track.artist?.["#text"] || ""} — ${track.name || ""}`,
								}
							: { hidden: true };
						writeNpCache(entry);
						applyNowPlaying(entry);
					} catch {
						nowPlayingEl.hidden = true;
					}
				}
				loadNowPlaying();
				clearInterval(npInterval);
				npInterval = setInterval(() => loadNowPlaying({ force: true }), 60_000);

				// ── Visit count (public aggregate-only endpoint) ──
				const visitsEl = document.getElementById("home-visits");
				async function loadVisits() {
					if (!visitsEl) return;
					try {
						const res = await fetch("/api/visit-count");
						if (!res.ok) return;
						const data = await res.json();
						if (typeof data.views !== "number") return;
						visitsEl.textContent = `${data.views.toLocaleString()} visits`;
						visitsEl.hidden = false;
					} catch {
						/* stay hidden */
					}
				}
				loadVisits();

				initBgm(signal);

				// ── Shortcuts dialog ──
				const dialog = document.getElementById("shortcuts-dialog") as
					| (HTMLElement & { open: boolean; showModal?: () => void; close?: () => void })
					| null;
				const openBtn = document.getElementById("shortcuts-btn");
				const closeBtn = document.getElementById("shortcuts-close");
				if (dialog && "showModal" in dialog) {
					const toggle = () => {
						if (dialog.open) dialog.close?.();
						else dialog.showModal?.();
					};
					openBtn?.addEventListener("click", toggle, { signal });
					closeBtn?.addEventListener("click", () => dialog.close?.(), { signal });
					dialog.addEventListener(
						"click",
						(e) => {
							if (e.target === dialog) dialog.close?.();
						},
						{ signal },
					);
					document.addEventListener(
						"keydown",
						(e) => {
							if (e.ctrlKey || e.metaKey || e.altKey) return;
							const target = e.target as HTMLElement;
							if (target.closest('input, textarea, select, [contenteditable="true"]')) return;
							if (e.key === "?") {
								e.preventDefault();
								toggle();
							}
						},
						{ signal },
					);
				}
			}

			// Same reasoning as initKeyboardNav: astro:page-load alone covers
			// both the first load and every transition. A redundant direct
			// call here raced initBgm()'s manifest fetch against itself.
			document.addEventListener("astro:page-load", initHeaderWidgets);
		</script>
	</body>
</html>
