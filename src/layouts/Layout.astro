---
import "../styles/global.css";

interface Props {
	title: string;
	description?: string;
	homepage?: boolean;
	navItems?: { href: string; label: string }[];
	homeHref?: string;
	noindex?: boolean;
}

const {
	title,
	description = ">merulox's terminal",
	homepage = false,
	navItems: customNavItems,
	homeHref = "/",
	noindex = false,
} = Astro.props;

const pathname = Astro.url.pathname;
const canonicalUrl = new URL(pathname, Astro.site ?? Astro.url.origin);

const defaultNavItems = [
	{ href: "/projects", label: "projects" },
	{ href: "/thinking", label: "writing" },
	{ href: "/music", label: "music" },
	{ href: "/reading", label: "reading" },
	{ href: "/links", label: "links" },
	{ href: "/log", label: "log" },
];

const navItems = customNavItems ?? defaultNavItems;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link
			rel="preload"
			href="/fonts/vt323-latin.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
	</head>
	<body>
		<header class="home-statusbar">
			<span class="home-brand">[navi]</span>
			<span class="home-host">merulox</span>
			<span class="home-tagline">cyberia's schemer boy</span>
			<span class="home-statusbar-spacer"></span>
			<span class="home-now-playing" id="now-playing" hidden></span>
			<span class="home-clock" id="home-clock"></span>
			<span class="home-visits" id="home-visits" hidden></span>
			<button
				class="home-shortcuts-btn"
				id="shortcuts-btn"
				type="button"
				aria-haspopup="dialog"
			>
				? shortcuts
			</button>
		</header>
		<dialog class="shortcuts-dialog" id="shortcuts-dialog">
			<div class="shortcuts-dialog-head">
				<span>keyboard shortcuts</span>
				<button id="shortcuts-close" type="button" aria-label="Close">×</button>
			</div>
			<dl class="shortcuts-list">
				<dt><kbd>j</kbd> <kbd>k</kbd> / <kbd><span class="glyph-fallback">↓</span></kbd> <kbd><span class="glyph-fallback">↑</span></kbd></dt>
				<dd>move through the list / rows</dd>
				<dt><kbd>h</kbd> <kbd>l</kbd> / <kbd><span class="glyph-fallback">←</span></kbd> <kbd><span class="glyph-fallback">→</span></kbd></dt>
				<dd>move across the top nav</dd>
				<dt><kbd>Enter</kbd></dt>
				<dd>open the highlighted item</dd>
				<dt><kbd>?</kbd></dt>
				<dd>toggle this panel</dd>
				<dt><kbd>Esc</kbd></dt>
				<dd>close</dd>
			</dl>
		</dialog>
		{
			homepage ? (
				<slot />
			) : (
				<div class="site-shell">
					<div class="site-pane">
						<header class="site-header">
							<a class="site-name kbd-item" href={homeHref}>
								MERULOX
							</a>
							<nav class="site-nav" aria-label="Primary navigation">
								{navItems.map((item) => {
									const itemPath = item.href.replace(/\/$/, "");
									const currentPath = pathname.replace(/\/$/, "");
									const isActive = currentPath === itemPath;
									return (
										<a
											href={item.href}
											class="kbd-item"
											aria-current={isActive ? "page" : undefined}
										>
											<span class="sel-arrow" aria-hidden="true">&gt;</span>
											{item.label}
										</a>
									);
								})}
							</nav>
						</header>
						<main>
							<slot />
						</main>
					</div>
				</div>
			)
		}
		<script>
			(function () {
				const navEls = Array.from(
					document.querySelectorAll<HTMLElement>(".site-name, .site-nav a"),
				);
				if (!navEls.length) return;

				const allListEls = Array.from(
					document.querySelectorAll<HTMLElement>(".list-item"),
				);
				const visibleListEls = () =>
					allListEls.filter((el) => !el.closest<HTMLElement>("[hidden]"));
				let listEls = visibleListEls();
				const rowGroups = Array.from(
					document.querySelectorAll<HTMLElement>(".kbd-row"),
				);

				const CUR = "kbd-cursor";
				const paint = (els: HTMLElement[], idx: number) =>
					els.forEach((el, i) => el.classList.toggle(CUR, i === idx));
				const clear = (els: HTMLElement[]) =>
					els.forEach((el) => el.classList.remove(CUR));
				const focusItem = (el: HTMLElement) => {
					if (document.activeElement === el) return;
					el.focus({ preventScroll: true });
				};

				const navStart = Math.max(
					0,
					navEls.findIndex((el) => el.getAttribute("aria-current") === "page"),
				);
				const skipTarget = (e: KeyboardEvent) => {
					// Let browser/OS shortcuts and unmanaged native controls behave normally.
					if (e.ctrlKey || e.metaKey || e.altKey) return true;
					const target = e.target as HTMLElement;
					const interactive = target.closest<HTMLElement>(
						'a, button, input, textarea, select, summary, [contenteditable="true"]',
					);
					return Boolean(
						interactive &&
							!navEls.includes(interactive) &&
							!listEls.includes(interactive) &&
							!interactive.classList.contains("row-item"),
					);
				};

				if (listEls.length) {
					// ── Two independent cursors (projects) ──
					//   Left/Right → nav,  Up/Down → project list
					let navIdx = navStart;
					let listIdx = 0;
					let last: "nav" | "list" = "list";
					const refreshListEls = (reset = false) => {
						const next = visibleListEls();
						if (!next.length) return;
						clear(allListEls);
						listEls = next;
						listIdx = reset ? 0 : Math.min(listIdx, listEls.length - 1);
						paint(listEls, listIdx);
					};
					paint(navEls, navIdx);
					paint(listEls, listIdx);

					document.addEventListener("focusin", (e) => {
						const t = e.target as HTMLElement;
						const n = navEls.indexOf(t);
						if (n !== -1) { navIdx = n; paint(navEls, n); last = "nav"; return; }
						const l = listEls.indexOf(t);
						if (l !== -1) { listIdx = l; paint(listEls, l); last = "list"; }
					});

					document.addEventListener("archive-panel-change", () => {
						refreshListEls(true);
					});

					document.addEventListener("keydown", (e) => {
						if (skipTarget(e)) return;
						refreshListEls();
						switch (e.key) {
							case "ArrowLeft": case "h":
								e.preventDefault();
								navIdx = (navIdx - 1 + navEls.length) % navEls.length;
								paint(navEls, navIdx);
								focusItem(navEls[navIdx]);
								last = "nav"; break;
							case "ArrowRight": case "l":
								e.preventDefault();
								navIdx = (navIdx + 1) % navEls.length;
								paint(navEls, navIdx);
								focusItem(navEls[navIdx]);
								last = "nav"; break;
							case "ArrowUp": case "k":
								e.preventDefault();
								listIdx = (listIdx - 1 + listEls.length) % listEls.length;
								paint(listEls, listIdx);
								focusItem(listEls[listIdx]);
								listEls[listIdx].scrollIntoView({ block: "nearest" }); last = "list"; break;
							case "ArrowDown": case "j":
								e.preventDefault();
								listIdx = (listIdx + 1) % listEls.length;
								paint(listEls, listIdx);
								focusItem(listEls[listIdx]);
								listEls[listIdx].scrollIntoView({ block: "nearest" }); last = "list"; break;
							case "Enter": {
								const a = document.activeElement as HTMLElement;
								if (navEls.includes(a) || listEls.includes(a)) return;
								e.preventDefault();
								(last === "list" ? listEls[listIdx] : navEls[navIdx]).click();
								break;
							}
						}
					});
					return;
				}

				// ── Single row/col cursor (music, now, writing, projects) ──
				//   Up/Down → between rows (nav, then each .kbd-row)
				//   Left/Right → within the current row
				//   .kbd-row groups inside a currently-hidden panel are skipped —
				//   rebuilt on every keypress so switching panels (archive-panel-change)
				//   reflects immediately without a stale row list.
				const buildRows = (): HTMLElement[][] =>
					[
						navEls,
						...rowGroups
							.filter((g) => !g.closest<HTMLElement>("[hidden]"))
							.map((g) => Array.from(g.querySelectorAll<HTMLElement>(".row-item"))),
					].filter((row) => row.length);

				let rows = buildRows();
				let r = 0;
				let c = navStart;
				const paintCell = () => {
					rows.forEach(clear);
					paint(rows[r], c);
				};
				const scrollIntoFullView = (el: HTMLElement) => {
					const margin = 24;
					const rect = el.getBoundingClientRect();
					const visualViewport = window.visualViewport;
					const viewportHeight = visualViewport?.height ?? window.innerHeight;
					const viewportOffsetTop = visualViewport?.offsetTop ?? 0;
					const absoluteTop = window.scrollY + viewportOffsetTop + rect.top;
					const absoluteBottom = absoluteTop + rect.height;
					const visibleTop = window.scrollY + viewportOffsetTop + margin;
					const visibleBottom = window.scrollY + viewportOffsetTop + viewportHeight - margin;
					const maxTop = document.documentElement.scrollHeight - viewportHeight;
					let top = window.scrollY;

					if (rect.height + margin * 2 <= viewportHeight) {
						if (absoluteBottom > visibleBottom) {
							top = absoluteBottom + margin - viewportOffsetTop - viewportHeight;
						}
						if (absoluteTop < visibleTop) {
							top = absoluteTop - margin - viewportOffsetTop;
						}
					} else {
						top = absoluteTop - margin - viewportOffsetTop;
					}

					window.scrollTo({
						top: Math.max(0, Math.min(top, maxTop)),
						behavior: "smooth",
					});
				};
				const scrollToPreview = (el: HTMLElement) => {
					const visualViewport = window.visualViewport;
					const viewportHeight = visualViewport?.height ?? window.innerHeight;
					const viewportOffsetTop = visualViewport?.offsetTop ?? 0;
					const previewHeight = Math.min(180, Math.max(120, viewportHeight * 0.16));
					const absoluteTop = window.scrollY + viewportOffsetTop + el.getBoundingClientRect().top;
					const maxTop = document.documentElement.scrollHeight - viewportHeight;

					window.scrollTo({
						top: Math.max(0, Math.min(
							absoluteTop - viewportOffsetTop - viewportHeight + previewHeight,
							maxTop,
						)),
						behavior: "smooth",
					});
				};
				const scrollForRow = () => {
					if (r === 0) {
						window.scrollTo({ top: 0, behavior: "smooth" });
						return;
					}

					const bar = rows[r][c].closest<HTMLElement>(".kbd-row");
					const scrollPreview = bar?.dataset.scrollPreview;
					if (scrollPreview) {
						const preview = document.querySelector<HTMLElement>(scrollPreview);
						if (preview) {
							scrollToPreview(preview);
							return;
						}
					}
					const scrollTarget = bar?.dataset.scrollTarget;
					if (scrollTarget) {
						const target = document.querySelector<HTMLElement>(scrollTarget);
						if (target) scrollIntoFullView(target);
					} else if (r === rows.length - 1) {
						// Last row → reveal everything below it (e.g. the last.fm link)
						window.scrollTo({ top: document.body.scrollHeight, behavior: "smooth" });
					} else {
						(bar || rows[r][c]).scrollIntoView({ block: "center", behavior: "smooth" });
					}
				};
				paintCell();

				const refreshRows = (reset = false) => {
					const next = buildRows();
					if (!next.length) return;
					rows = next;
					r = reset ? 0 : Math.min(r, rows.length - 1);
					c = Math.min(c, rows[r].length - 1);
				};
				document.addEventListener("archive-panel-change", () => {
					refreshRows();
					paintCell();
				});

				document.addEventListener("focusin", (e) => {
					const t = e.target as HTMLElement;
					for (let ri = 0; ri < rows.length; ri++) {
						const ci = rows[ri].indexOf(t);
						if (ci !== -1) { r = ri; c = ci; paintCell(); return; }
					}
				});

				document.addEventListener("keydown", (e) => {
					if (skipTarget(e)) return;
					refreshRows();
					switch (e.key) {
						case "ArrowUp": case "k":
							if (rows.length > 1) {
								e.preventDefault();
								r = (r - 1 + rows.length) % rows.length;
								c = Math.min(c, rows[r].length - 1);
								paintCell();
								focusItem(rows[r][c]);
								scrollForRow();
							}
							break;
						case "ArrowDown": case "j":
							if (rows.length > 1) {
								e.preventDefault();
								r = (r + 1) % rows.length;
								c = Math.min(c, rows[r].length - 1);
								paintCell();
								focusItem(rows[r][c]);
								scrollForRow();
							}
							break;
						case "ArrowLeft": case "h":
							e.preventDefault();
							c = (c - 1 + rows[r].length) % rows[r].length;
							paintCell();
							focusItem(rows[r][c]); break;
						case "ArrowRight": case "l":
							e.preventDefault();
							c = (c + 1) % rows[r].length;
							paintCell();
							focusItem(rows[r][c]); break;
						case "Enter": {
							const a = document.activeElement as HTMLElement;
							if (rows.some((row) => row.includes(a))) return;
							e.preventDefault();
							rows[r][c].click();
							break;
						}
					}
				});
			})();
		</script>
		<script>
			(function () {
				const LFM_API_KEY = "9fdb2ae95fb0b95470334c260149c3cb";
				const LFM_USER = "merulox";
				const EASTERN = "America/New_York";

				// ── Clock ──
				const clockEl = document.getElementById("home-clock");
				const clockFmt = new Intl.DateTimeFormat("en-US", {
					timeZone: EASTERN,
					month: "short",
					day: "2-digit",
					hour: "2-digit",
					minute: "2-digit",
					hour12: false,
				});
				function tickClock() {
					if (clockEl) clockEl.textContent = clockFmt.format(new Date());
				}
				tickClock();
				setInterval(tickClock, 30_000);

				// ── Now playing (last.fm), cached across page navigations ──
				const nowPlayingEl = document.getElementById("now-playing");
				const NP_CACHE_KEY = "merulox-np-cache";
				const NP_CACHE_MS = 120_000; // 2 minutes

				function applyNowPlaying(entry: { hidden: boolean; html?: string }) {
					if (!nowPlayingEl) return;
					if (!entry || entry.hidden) {
						nowPlayingEl.hidden = true;
						return;
					}
					nowPlayingEl.innerHTML = entry.html ?? "";
					nowPlayingEl.hidden = false;
				}
				function readNpCache(): { hidden: boolean; html?: string } | null {
					try {
						const raw = sessionStorage.getItem(NP_CACHE_KEY);
						if (!raw) return null;
						const parsed = JSON.parse(raw);
						if (Date.now() - parsed.ts > NP_CACHE_MS) return null;
						return parsed;
					} catch {
						return null; // private mode / storage disabled — just skip caching
					}
				}
				function writeNpCache(entry: { hidden: boolean; html?: string }) {
					try {
						sessionStorage.setItem(NP_CACHE_KEY, JSON.stringify({ ...entry, ts: Date.now() }));
					} catch {
						/* ignore */
					}
				}
				async function loadNowPlaying(opts: { force?: boolean } = {}) {
					if (!nowPlayingEl) return;
					if (!opts.force) {
						const cached = readNpCache();
						if (cached) {
							applyNowPlaying(cached);
							return;
						}
					}
					try {
						const res = await fetch(
							`https://ws.audioscrobbler.com/2.0/?method=user.getrecenttracks&user=${LFM_USER}&api_key=${LFM_API_KEY}&limit=1&format=json`,
						);
						const data = await res.json();
						const track = data.recenttracks?.track?.[0];
						const isNowPlaying = track?.["@attr"]?.nowplaying === "true";
						const entry = isNowPlaying && track
							? {
									hidden: false,
									html: `<span class="np-note">♪</span> ${track.artist?.["#text"] || ""} — ${track.name || ""}`,
								}
							: { hidden: true };
						writeNpCache(entry);
						applyNowPlaying(entry);
					} catch {
						nowPlayingEl.hidden = true;
					}
				}
				loadNowPlaying();
				setInterval(() => loadNowPlaying({ force: true }), 60_000);

				// ── Visit count (public aggregate-only endpoint) ──
				const visitsEl = document.getElementById("home-visits");
				async function loadVisits() {
					if (!visitsEl) return;
					try {
						const res = await fetch("/api/visit-count");
						if (!res.ok) return;
						const data = await res.json();
						if (typeof data.views !== "number") return;
						visitsEl.textContent = `${data.views.toLocaleString()} visits`;
						visitsEl.hidden = false;
					} catch {
						/* stay hidden */
					}
				}
				loadVisits();

				// ── Shortcuts dialog ──
				const dialog = document.getElementById("shortcuts-dialog");
				const openBtn = document.getElementById("shortcuts-btn");
				const closeBtn = document.getElementById("shortcuts-close");
				if (dialog && "showModal" in dialog) {
					const toggle = () => {
						if (dialog.open) dialog.close();
						else dialog.showModal();
					};
					openBtn?.addEventListener("click", toggle);
					closeBtn?.addEventListener("click", () => dialog.close());
					dialog.addEventListener("click", (e) => {
						if (e.target === dialog) dialog.close();
					});
					document.addEventListener("keydown", (e) => {
						if (e.ctrlKey || e.metaKey || e.altKey) return;
						const target = e.target as HTMLElement;
						if (target.closest('input, textarea, select, [contenteditable="true"]')) return;
						if (e.key === "?") {
							e.preventDefault();
							toggle();
						}
					});
				}
			})();
		</script>
	</body>
</html>
