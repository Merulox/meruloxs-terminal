---
import Layout from "../layouts/Layout.astro";
---

<style>
	#links-manager :global(.contact-block) {
		display: grid;
		gap: 4px;
		margin-bottom: 18px;
	}
	#links-manager :global(.guestbook-button) {
		align-items: center;
		border: 1px solid var(--line);
		display: inline-flex;
		font-family: "SFMono-Regular", Consolas, monospace;
		font-size: 12px;
		gap: 8px;
		padding: 8px 12px;
		text-decoration: none;
		justify-self: start;
	}
	#links-manager :global(.guestbook-button::before) {
		content: "🪐";
		font-size: 13px;
		line-height: 1;
	}
	#links-manager :global(.guestbook-button:hover),
	#links-manager :global(.guestbook-button:focus-visible) {
		border-color: var(--accent);
		color: var(--accent);
		outline: none;
	}
	#links-manager :global(.guestbook-button.kbd-cursor) {
		border-color: var(--accent);
		box-shadow: inset 2px 0 0 var(--accent);
		color: var(--accent);
	}
	#links-manager :global(.contact-line) {
		display: grid;
		grid-template-columns: 74px minmax(0, 1fr);
		gap: 12px;
		font-size: 13px;
	}
	#links-manager :global(.contact-label) {
		color: var(--muted);
		font-family: "SFMono-Regular", Consolas, monospace;
		font-size: 11px;
		text-transform: lowercase;
	}
	#links-manager :global(.crypto-addresses) {
		margin: 14px 0 0;
	}
	#links-manager :global(.copy-address) {
		background: none;
		border: 0;
		color: inherit;
		cursor: copy;
		display: inline-block;
		font: inherit;
		max-width: 100%;
		min-width: 0;
		overflow-x: auto;
		padding: 0;
		text-align: left;
	}
	#links-manager :global(.copy-address:hover),
	#links-manager :global(.copy-address:focus-visible) {
		color: var(--accent);
		outline: none;
		text-decoration: underline;
		text-decoration-style: dotted;
		text-underline-offset: 3px;
	}
	#links-manager :global(.address-value) {
		white-space: nowrap;
	}
	#links-manager :global(.copy-status) {
		border: 0;
		clip: rect(0 0 0 0);
		height: 1px;
		margin: -1px;
		overflow: hidden;
		padding: 0;
		position: absolute;
		white-space: nowrap;
		width: 1px;
	}
	#links-manager :global(.links-list) {
		border-bottom: 1px solid var(--line);
		display: grid;
	}
	#links-manager :global(.link-group + .link-group) {
		margin-top: 34px;
	}
	#links-manager :global(.links-list > a),
	#links-manager :global(.split-link) {
		border-top: 1px solid var(--line);
	}
	#links-manager :global(.links-list a) {
		align-items: baseline;
		display: grid;
		grid-template-columns: 16px minmax(0, 1fr) auto;
		gap: 10px;
		padding: 12px 0;
		text-decoration: none;
	}
	#links-manager :global(.split-link) {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}
	#links-manager :global(.split-link > a:first-child) {
		padding-right: 12px;
	}
	#links-manager :global(.split-link > a + a) {
		border-left: 1px solid var(--line);
		padding-left: 12px;
	}
	#links-manager :global(.links-list a::before) {
		color: var(--accent);
		content: ">";
		font-family: "SFMono-Regular", Consolas, monospace;
		font-size: 11px;
	}
	#links-manager :global(.link-host) {
		color: var(--muted);
		font-family: "SFMono-Regular", Consolas, monospace;
		font-size: 11px;
		white-space: nowrap;
	}
	#links-manager :global(.links-list a.dead) {
		opacity: 0.45;
	}
	#links-manager :global(.links-list a:hover .link-label) {
		color: var(--accent);
	}
	#links-manager :global(.links-list a.kbd-cursor) {
		background: rgba(78, 184, 196, 0.08);
		box-shadow: inset 2px 0 0 var(--accent);
	}
	#links-manager :global(.links-list a.kbd-cursor .link-label) {
		color: var(--accent);
	}
	#links-manager :global(.links-empty) {
		border-top: 1px solid var(--line);
		color: var(--muted);
		font-family: "SFMono-Regular", Consolas, monospace;
		font-size: 11px;
		padding: 12px 0;
	}
	@media (max-width: 600px) {
		#links-manager :global(.contact-line),
		#links-manager :global(.links-list a) {
			grid-template-columns: 16px minmax(0, 1fr);
		}
		#links-manager :global(.contact-label) {
			grid-column: 1 / -1;
		}
		#links-manager :global(.crypto-addresses .copy-address) {
			grid-column: 1 / -1;
		}
		#links-manager :global(.link-host) {
			grid-column: 2;
			overflow-wrap: anywhere;
			white-space: normal;
		}
		#links-manager :global(.split-link .link-host) {
			display: none;
		}
	}
	#links-manager :global([hidden]) { display: none !important; }
	#links-manager :global(.link-entry) { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 12px; min-width: 0; }
	#links-manager :global(.links-list > .link-entry) { border-top: 1px solid var(--line); }
	#links-manager :global(.split-link > .link-entry + .link-entry) { border-left: 1px solid var(--line); padding-left: 12px; }
	#links-manager :global(.split-link > .link-entry:first-child) { padding-right: 12px; }
	#links-manager :global(.contact-line.is-hidden > :not(.link-actions)),
	#links-manager :global(.link-entry.is-hidden > .copy-address),
	#links-manager :global(.is-hidden > a),
	#links-manager :global(.is-hidden > .contact-line) { opacity: 0.45; }
	#links-manager :global(.link-actions) { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
	#links-manager :global(.contact-line.link-entry) { grid-template-columns: 74px minmax(0, 1fr); }
	#links-manager :global(.contact-line:has(> .link-actions)) { grid-template-columns: 74px minmax(0, 1fr) auto; }
	#links-manager :global(.visibility-toggle),
	#links-manager :global(.link-actions button),
	#links-manager :global(.new-link),
	#links-manager :global(.link-add-form button),
	#links-manager > button { background: transparent; color: var(--muted); border: 1px solid var(--line); padding: 5px 8px; font: 11px "SFMono-Regular", Consolas, monospace; cursor: pointer; }
	#links-manager :global(.visibility-toggle[aria-checked="true"]) { color: var(--accent); }
	#links-manager :global(button:hover),
	#links-manager :global(button:focus-visible),
	#links-manager :global(button.kbd-cursor) { color: var(--accent); border-color: var(--accent); outline: 1px solid var(--accent); outline-offset: 2px; }
	#links-manager :global(button:disabled) { cursor: wait; opacity: 0.55; }
	#links-manager :global(.new-link) { display: block; margin-top: 14px; border-style: dashed; }
	#links-manager :global(.link-add-form) { display: grid; gap: 12px; margin-top: 14px; padding: 16px; border: 1px solid var(--line); }
	#links-manager :global(.link-add-form label) { display: grid; gap: 5px; font-size: 12px; color: var(--muted); }
	#links-manager :global(.link-add-form input:not([type="checkbox"])) { box-sizing: border-box; width: 100%; min-width: 0; padding: 8px; background: transparent; color: inherit; border: 1px solid var(--line); font: inherit; }
	#links-manager :global(.link-add-form input:focus-visible) { outline: 1px solid var(--accent); }
	#links-manager :global(.link-add-form label:has(input[type="checkbox"])) { display: flex; align-items: center; }
	#links-manager :global(.form-actions) { display: flex; gap: 8px; }
	#links-manager [data-links-status] { color: var(--muted); font-size: 12px; }
	#links-manager :global(.links-propagation-note) { color: var(--muted); font-size: 12px; }
	#links-manager [data-links-status]:empty { display: none; }
	#links-manager :global(.link-group) { margin-top: 24px; }
	@media (max-width: 600px) {
		#links-manager :global(.link-entry) { gap: 8px; }
		#links-manager :global(.split-link .link-entry) { grid-template-columns: minmax(0, 1fr); }
		#links-manager :global(.link-actions) { padding: 4px 0; }
		#links-manager :global(.contact-line.link-entry),
		#links-manager :global(.contact-line:has(> .link-actions)) { grid-template-columns: minmax(0, 1fr) auto; }
		#links-manager :global(.contact-line:has(> .link-actions) > .copy-address) { grid-column: auto; }
	}
</style>

<Layout title="links | MERULOX" description="Where to find merulox.">
	<div class="page-head">
		<h1>Links</h1>
		<span class="date">profiles and contact</span>
	</div>
	<div id="links-manager">
		<p data-links-status role="status" aria-live="polite">Loading links…</p>
		<button data-links-retry type="button" hidden>Retry loading links</button>
		<div data-links-sections></div>
		<noscript>Enable JavaScript to load the current public links.</noscript>
	</div>
	<script>
		import { mountLinksEditor } from "../lib/links-editor.mjs";
		let cleanup: (() => void) | undefined;
		function stopLinks() {
			cleanup?.();
			cleanup = undefined;
		}
		function initLinks() {
			stopLinks();
			const root = document.getElementById("links-manager");
			if (root) cleanup = mountLinksEditor(root);
		}
		document.addEventListener("astro:before-swap", stopLinks);
		document.addEventListener("astro:page-load", initLinks);
	</script>
</Layout>
