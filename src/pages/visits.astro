---
// Dev-only tab: functions/visits/_middleware.js returns 404 for /visits on every
// host except dev.merulox.com, which the root middleware puts behind auth.
import Layout from "../layouts/Layout.astro";
import { WORLD_LAND_PATH } from "../data/world-land";

const ranges = [
	["24h", "24 hours"],
	["7d", "7 days"],
	["30d", "30 days"],
	["90d", "90 days"],
	["all", "all time"],
];
---

<Layout title="visits | MERULOX" description="merulox.com visits by location." noindex={true}>
	<h1>Visits</h1>

	<div class="period-bar kbd-row" role="group" aria-label="Visit time range">
		{
			ranges.map(([value, label]) => (
				<button class:list={["period-btn", "row-item", { active: value === "30d" }]} data-range={value} type="button">
					{label}
				</button>
			))
		}
	</div>

	<p class="vis-summary" id="vis-summary" aria-live="polite">loading…</p>

	<div class="vis-overview">
		<figure class="vis-map">
			<svg viewBox="0 0 360 150" role="img" aria-labelledby="vis-map-title">
				<title id="vis-map-title">merulox.com visits by location</title>
				<path class="vis-land" d={WORLD_LAND_PATH} />
				<g id="vis-points"></g>
			</svg>
		</figure>

		<div class="vis-daily" id="vis-daily" aria-hidden="true"></div>

		<div class="vis-grid">
			<section><h2>countries</h2><ol class="vis-list" id="vis-countries"></ol></section>
			<section><h2>cities</h2><ol class="vis-list" id="vis-cities"></ol></section>
			<section><h2>top IPs</h2><ol class="vis-list" id="vis-ips"></ol></section>
			<section><h2>pages</h2><ol class="vis-list" id="vis-paths"></ol></section>
			<section><h2>referrers</h2><ol class="vis-list" id="vis-referrers"></ol></section>
		</div>
	</div>

	<section class="vis-recent">
		<h2>history</h2>
		<div class="pager-host" id="vis-recent-pager-top"></div>
		<p class="vis-empty" id="vis-recent-empty" hidden>none yet</p>
		<div class="vis-table-wrap">
			<table>
				<thead><tr><th>time</th><th>ip</th><th>location</th><th>page</th><th>referrer</th><th class="num">views</th><th>source</th></tr></thead>
				<tbody id="vis-recent"></tbody>
			</table>
		</div>
		<div class="pager-host" id="vis-recent-pager-bottom"></div>
	</section>

	<div class="ip-backdrop" id="ip-backdrop" hidden></div>
	<aside class="ip-panel" id="ip-panel" aria-labelledby="ip-panel-title" aria-hidden="true">
		<header class="ip-panel-head">
			<h2 id="ip-panel-title">—</h2>
			<button class="ip-close" id="ip-close" type="button" aria-label="Close IP panel">esc ×</button>
		</header>
		<div class="ip-panel-body" id="ip-panel-body"></div>
	</aside>

	<p class="vis-note">
		Cookieless beacon on merulox.com. Each view stores the visitor IP
		(Cloudflare CF-Connecting-IP) and Cloudflare's city-level location estimate.
		Rows marked "cf log" were backfilled from Cloudflare's request logs (last ~31
		days before tracking began): sampled counts, bot-filtered by user agent only,
		location from the DB-IP Lite database, no referrer, and not counted as visits;
		"views" shows how many sampled requests a cf log row stands for. Click an IP for
		its full history, network details (reverse DNS automatically; ASN/org from ipinfo.io only on request), and
		lookup links. IP geolocation for imported rows by
		<a href="https://db-ip.com">DB-IP</a> (CC BY 4.0).
		visits = first page of a browser tab session; views = every page load. Exclude
		your own browser with <a href="https://merulox.com/?notrack=1">merulox.com/?notrack=1</a>
		(undo with <code>?notrack=0</code>).
	</p>
</Layout>

<script>
	type Row = { views: number; visits: number | null };
	type Point = Row & { lat: number; lon: number; city: string | null; region: string | null; country: string | null };
	type Summary = {
		totals: { views: number; visits: number | null; countries: number; ips: number; imported: number; first: number | null };
		points: Point[];
		countries: (Row & { country: string | null })[];
		cities: (Row & { city: string; region: string | null; country: string | null })[];
		ips: (Row & { ip: string })[];
		paths: (Row & { path: string })[];
		referrers: (Row & { referrer: string })[];
		daily: (Row & { day: string })[];
	};

	const SVG = "http://www.w3.org/2000/svg";
	const names = new Intl.DisplayNames(["en"], { type: "region" });
	const countryName = (code: string | null) => {
		if (!code || code === "XX" || code === "T1") return code === "T1" ? "Tor" : "unknown";
		try {
			return names.of(code) ?? code;
		} catch {
			return code;
		}
	};
	const place = (p: { city: string | null; region: string | null; country: string | null }) =>
		[p.city, p.region, countryName(p.country)].filter(Boolean).join(", ");
	const n = (value: number | null | undefined) => (value ?? 0).toLocaleString("en");

	const $ = (id: string) => document.getElementById(id)!;

	type HistoryRow = {
		ts: number; ip: string | null; path: string; entry: number; referrer: string | null;
		city: string | null; region: string | null; country: string | null; colo: string | null;
		source: string; weight: number;
	};
	type HistoryPage = { rows: HistoryRow[]; total: number; page: number; pages: number; size: number };

	function renderList(id: string, rows: Row[], label: (row: any) => string) {
		const list = $(id);
		list.replaceChildren();
		if (!rows.length) {
			const empty = document.createElement("li");
			empty.className = "vis-empty";
			empty.textContent = "none yet";
			list.append(empty);
			return;
		}
		const max = Math.max(...rows.map((row) => row.views));
		for (const row of rows) {
			const item = document.createElement("li");
			item.style.setProperty("--share", `${(row.views / max) * 100}%`);
			const name = document.createElement("span");
			name.className = "vis-name";
			name.textContent = label(row);
			const count = document.createElement("span");
			count.className = "vis-count";
			count.textContent = n(row.views);
			count.title = `${n(row.views)} views · ${n(row.visits)} visits`;
			item.append(name, count);
			list.append(item);
		}
	}

	function renderIps(rows: Summary["ips"]) {
		const list = $("vis-ips");
		list.replaceChildren();
		if (!rows.length) {
			const empty = document.createElement("li");
			empty.className = "vis-empty";
			empty.textContent = "none yet";
			list.append(empty);
			return;
		}
		const max = Math.max(...rows.map((row) => row.views));
		for (const row of rows) {
			const item = document.createElement("li");
			item.style.setProperty("--share", `${(row.views / max) * 100}%`);
			const name = ipButton(row.ip);
			name.classList.add("vis-name");
			const count = document.createElement("span");
			count.className = "vis-count";
			count.textContent = n(row.views);
			count.title = `${n(row.views)} views · ${n(row.visits)} visits`;
			item.append(name, count);
			list.append(item);
		}
	}

	function renderMap(points: Point[]) {
		const group = $("vis-points");
		group.replaceChildren();
		const max = Math.max(1, ...points.map((p) => p.views));
		// Largest first so small bubbles stay on top and hoverable.
		for (const p of [...points].sort((a, b) => b.views - a.views)) {
			const circle = document.createElementNS(SVG, "circle");
			circle.setAttribute("cx", String(p.lon + 180));
			circle.setAttribute("cy", String(90 - p.lat));
			circle.setAttribute("r", String(1.2 + 5.8 * Math.sqrt(p.views / max)));
			circle.setAttribute("class", "vis-point");
			const title = document.createElementNS(SVG, "title");
			title.textContent = `${place(p)} — ${n(p.views)} views, ${n(p.visits)} visits`;
			circle.append(title);
			group.append(circle);
		}
	}

	// Continuous UTC day axis from the range start (or first visit) to today.
	function fillDays(rows: Summary["daily"], since: number, first: number | null) {
		if (!first || !rows.length) return [];
		const byDay = new Map(rows.map((row) => [row.day, row]));
		const start = new Date(Math.max(since, first) * 1000);
		start.setUTCHours(0, 0, 0, 0);
		const days: Summary["daily"] = [];
		for (const d = start; d.getTime() <= Date.now(); d.setUTCDate(d.getUTCDate() + 1)) {
			const day = d.toISOString().slice(0, 10);
			days.push(byDay.get(day) ?? { day, views: 0, visits: 0 });
		}
		return days;
	}

	function renderDaily(days: Summary["daily"]) {
		const box = $("vis-daily");
		box.replaceChildren();
		const max = Math.max(1, ...days.map((d) => d.views));
		for (const day of days) {
			const bar = document.createElement("span");
			bar.style.height = day.views ? `${Math.max(6, (day.views / max) * 100)}%` : "1px";
			bar.title = `${day.day}: ${n(day.views)} views`;
			box.append(bar);
		}
		box.hidden = days.length < 2;
	}

	const when = (ts: number) => new Date(ts * 1000).toLocaleString("en-CA", { hour12: false }).replace(",", "");
	const sourceLabel = (source: string) => (source === "cloudflare" ? "cf log" : "beacon");

	function cell(tr: HTMLTableRowElement, value: string | Node, className = "") {
		const td = document.createElement("td");
		if (className) td.className = className;
		td.append(value);
		tr.append(td);
	}

	function ipButton(ip: string) {
		const button = document.createElement("button");
		button.type = "button";
		button.className = "ip-link";
		button.dataset.ip = ip;
		button.textContent = ip;
		return button;
	}

	function el<K extends keyof HTMLElementTagNameMap>(tag: K, text?: string, className?: string) {
		const node = document.createElement(tag);
		if (text !== undefined) node.textContent = text;
		if (className) node.className = className;
		return node;
	}

	// ── Paged history (shared by the main table and the IP panel) ─────────
	const PAGE_SIZES = [25, 50, 100, 200];
	const SIZE_KEY = "mx-visits-page-size";
	const savedSize = () => {
		const size = Number(localStorage.getItem(SIZE_KEY));
		return PAGE_SIZES.includes(size) ? size : 50;
	};

	type Pager = { reload: (page?: number) => Promise<void> };

	// query(page, size) -> API URL. Navigation replaces rows; "load more" appends the next page.
	function pagedHistory(options: {
		body: HTMLElement;
		empty: HTMLElement;
		hosts: HTMLElement[];
		query: (page: number, size: number) => string;
		row: (row: HistoryRow) => HTMLTableRowElement;
		alive?: () => boolean;
	}): Pager {
		let first = 1;
		let last = 1;
		let state: HistoryPage | null = null;
		let request = 0;
		let busy = false;

		async function fetchPage(page: number, size: number) {
			const response = await fetch(options.query(page, size), { cache: "no-store" });
			if (!response.ok) throw new Error(String(response.status));
			return (await response.json()) as HistoryPage;
		}

		function renderPager() {
			for (const host of options.hosts) {
				host.replaceChildren();
				if (!state || state.total === 0) continue;
				const nav = el("nav", undefined, "pager");
				nav.setAttribute("aria-label", "history pages");
				const button = (label: string, title: string, target: number, disabled: boolean) => {
					const b = el("button", label, "pager-btn");
					b.type = "button";
					b.title = title;
					b.disabled = disabled || busy;
					b.addEventListener("click", () => go(target));
					return b;
				};
				const from = (first - 1) * state.size + 1;
				const to = Math.min(last * state.size, state.total);
				nav.append(
					button("«", "first page", 1, first === 1),
					button("‹", "previous page", first - 1, first === 1),
				);
				const jump = el("input", undefined, "pager-jump");
				jump.type = "number";
				jump.min = "1";
				jump.max = String(state.pages);
				jump.value = String(last);
				jump.setAttribute("aria-label", "page number");
				const commit = () => {
					const target = Math.min(state!.pages, Math.max(1, Math.round(Number(jump.value) || 1)));
					if (target !== last || first !== last) go(target);
					else jump.value = String(last);
				};
				jump.addEventListener("focus", () => jump.select());
				jump.addEventListener("change", commit);
				jump.addEventListener("keydown", (event) => {
					if (event.key === "Enter") {
						event.preventDefault();
						commit();
					}
				});
				const of = el("span", `/ ${n(state.pages)}`, "pager-of");
				nav.append(jump, of);
				nav.append(
					button("›", "next page", last + 1, last >= state.pages),
					button("»", "last page", state.pages, last >= state.pages),
				);
				nav.append(el("span", `rows ${n(from)}–${n(to)} of ${n(state.total)}`, "pager-range"));
				const size = el("select", undefined, "pager-size");
				size.setAttribute("aria-label", "rows per page");
				for (const value of PAGE_SIZES) {
					const option = el("option", `${value} / page`);
					option.value = String(value);
					option.selected = value === state.size;
					size.append(option);
				}
				size.disabled = busy;
				size.addEventListener("change", () => {
					localStorage.setItem(SIZE_KEY, size.value);
					// Keep roughly the same position when the page size changes.
					go(Math.floor(((first - 1) * state!.size) / Number(size.value)) + 1);
				});
				nav.append(size);
				if (last < state.pages) {
					const more = el("button", `load ${n(Math.min(state.size, state.total - to))} more`, "pager-btn pager-more");
					more.type = "button";
					more.disabled = busy;
					more.addEventListener("click", loadMore);
					nav.append(more);
				}
				host.append(nav);
			}
		}

		function paint(rows: HistoryRow[], append: boolean) {
			if (!append) options.body.replaceChildren();
			for (const row of rows) options.body.append(options.row(row));
			options.empty.textContent = "none yet";
			options.empty.hidden = (state?.total ?? 0) > 0;
		}

		async function go(page: number) {
			const id = ++request;
			busy = true;
			renderPager();
			try {
				const result = await fetchPage(Math.max(1, page), savedSize());
				if (id !== request || options.alive?.() === false) return;
				state = result;
				first = last = result.page;
				paint(result.rows, false);
			} catch (error) {
				if (id !== request) return;
				options.body.replaceChildren();
				options.empty.hidden = false;
				options.empty.textContent = `could not load history (${(error as Error).message})`;
			} finally {
				if (id === request) {
					busy = false;
					renderPager();
				}
			}
		}

		async function loadMore() {
			if (!state || last >= state.pages) return;
			const id = ++request;
			busy = true;
			renderPager();
			try {
				const result = await fetchPage(last + 1, state.size);
				if (id !== request || options.alive?.() === false) return;
				// Totals can shift if new visits arrive; take the fresh counts.
				state = { ...result };
				last = result.page;
				paint(result.rows, true);
			} finally {
				if (id === request) {
					busy = false;
					renderPager();
				}
			}
		}

		return { reload: (page = 1) => go(page) };
	}

	function recentRow(row: HistoryRow) {
		const tr = document.createElement("tr");
		cell(tr, when(row.ts), "nowrap");
		cell(tr, row.ip ? ipButton(row.ip) : "—", "nowrap");
		cell(tr, place(row), "wrap");
		cell(tr, row.path, "wrap");
		cell(tr, row.referrer ?? "", "wrap");
		cell(tr, row.weight > 1 ? `×${n(row.weight)}` : "1", "num");
		cell(tr, sourceLabel(row.source), "nowrap muted");
		return tr;
	}

	let currentRange = "30d";
	const recent = pagedHistory({
		body: $("vis-recent"),
		empty: $("vis-recent-empty"),
		hosts: [$("vis-recent-pager-top"), $("vis-recent-pager-bottom")],
		query: (page, size) => `/api/visits?view=history&range=${encodeURIComponent(currentRange)}&page=${page}&size=${size}`,
		row: recentRow,
	});

	// ── IP panel ──────────────────────────────────────────────────────────
	type FingerprintSnapshot = {
		ts: number;
		path: string;
		sessionId: string;
		hash: string;
		attributes: Record<string, unknown>;
	};
	type IpDetail = {
		ip: string;
		totals: { views: number; visits: number; rows: number; days: number; imported: number; first: number | null; last: number | null };
		paths: (Row & { path: string })[];
		places: (Row & { city: string | null; region: string | null; country: string | null; lat: number | null; lon: number | null })[];
		fingerprints: FingerprintSnapshot[];
	};
	type Network = {
		ipinfo: "ok" | "unavailable" | "not queried";
		reverseDns: string[]; asn: string | null; org: string | null; hostname: string | null;
		city: string | null; region: string | null; country: string | null; postal: string | null;
		timezone: string | null; loc: string | null; anycast: boolean; bogon: boolean;
	};

	const panel = $("ip-panel");
	const backdrop = $("ip-backdrop");
	const panelBody = $("ip-panel-body");
	let lastFocus: HTMLElement | null = null;
	let panelRequest = 0;

	function facts(rows: [string, string | Node | null | undefined][]) {
		const dl = el("dl", undefined, "ip-facts");
		for (const [label, value] of rows) {
			if (value === null || value === undefined || value === "") continue;
			dl.append(el("dt", label));
			const dd = el("dd");
			dd.append(value);
			dl.append(dd);
		}
		return dl;
	}

	function section(title: string, ...children: Node[]) {
		const wrap = el("section", undefined, "ip-section");
		wrap.append(el("h3", title), ...children);
		return wrap;
	}

	function fingerprintValue(value: unknown) {
		if (value === null || value === undefined) return "unavailable";
		if (typeof value === "string") return value || "(empty)";
		if (typeof value === "number" || typeof value === "boolean") return String(value);
		return JSON.stringify(value);
	}

	function fingerprintSnapshot(snapshot: FingerprintSnapshot, expanded: boolean) {
		const wrap = el("article", undefined, "fp-snapshot");
		wrap.append(
			facts([
				["captured", when(snapshot.ts)],
				["page", snapshot.path],
				["fingerprint", snapshot.hash],
				["tab session", snapshot.sessionId],
			]),
		);
		const groups = el("div", undefined, "fp-groups");
		for (const [name, value] of Object.entries(snapshot.attributes)) {
			const detail = el("details", undefined, "fp-group");
			detail.open = expanded && ["browser", "screen"].includes(name);
			detail.append(el("summary", name));
			if (value && typeof value === "object" && !Array.isArray(value)) {
				detail.append(
					facts(Object.entries(value as Record<string, unknown>).map(([key, child]) => [key, fingerprintValue(child)])),
				);
			} else {
				detail.append(el("pre", fingerprintValue(value)));
			}
			groups.append(detail);
		}
		wrap.append(groups);
		return wrap;
	}

	function toolLinks(ip: string, network: Network | null) {
		const q = encodeURIComponent(ip);
		const asnNumber = network?.asn?.replace(/^AS/, "");
		const links: [string, string][] = [
			["ipinfo", `https://ipinfo.io/${q}`],
			["Melissa", `https://lookups.melissa.com/home/iplocation/ip/?ip=${q}`],
			["AbuseIPDB", `https://www.abuseipdb.com/check/${q}`],
			["GreyNoise", `https://viz.greynoise.io/ip/${q}`],
			["Shodan", `https://www.shodan.io/host/${q}`],
			["Censys", `https://search.censys.io/hosts/${q}`],
			["VirusTotal", `https://www.virustotal.com/gui/ip-address/${q}`],
			["Spur (VPN/proxy)", `https://spur.us/context/${q}`],
			["IPQualityScore", `https://www.ipqualityscore.com/free-ip-lookup-proxy-vpn-test/lookup/${q}`],
			["Talos", `https://talosintelligence.com/reputation_center/lookup?search=${q}`],
			["AlienVault OTX", `https://otx.alienvault.com/indicator/ip/${q}`],
			["RDAP whois", `https://rdap.org/ip/${q}`],
			["bgp.he.net", `https://bgp.he.net/ip/${q}`],
			["robtex", `https://www.robtex.com/ip-lookup/${q}`],
			["urlscan", `https://urlscan.io/search/#ip:%22${q}%22`],
		];
		if (asnNumber) links.push([`${network!.asn} (bgp.he.net)`, `https://bgp.he.net/AS${asnNumber}`]);
		if (network?.loc) links.push(["map", `https://www.openstreetmap.org/?mlat=${network.loc.split(",")[0]}&mlon=${network.loc.split(",")[1]}#map=11/${network.loc.replace(",", "/")}`]);
		const list = el("ul", undefined, "ip-tools");
		for (const [label, href] of links) {
			const li = el("li");
			const a = el("a", label);
			a.href = href;
			a.target = "_blank";
			a.rel = "noopener noreferrer";
			li.append(a);
			list.append(li);
		}
		return list;
	}

	function ipHistoryRow(row: HistoryRow) {
		const tr = document.createElement("tr");
		cell(tr, when(row.ts), "nowrap");
		cell(tr, row.path + (row.entry ? " ↵" : ""), "nowrap");
		cell(tr, place(row) + (row.colo ? ` · ${row.colo}` : ""), "wrap");
		cell(tr, row.referrer ?? "", "wrap");
		cell(tr, row.weight > 1 ? `×${n(row.weight)}` : "1", "num");
		cell(tr, sourceLabel(row.source), "nowrap muted");
		return tr;
	}

	function renderNetwork(host: HTMLElement, links: HTMLElement, ip: string, net: Network, request: number) {
		const netPlace = [net.city, net.region, net.country ? countryName(net.country) : null].filter(Boolean).join(", ");
		const flags = [net.anycast && "anycast", net.bogon && "bogon / private"].filter(Boolean).join(", ");
		let ipinfoState: string | Node = net.ipinfo === "ok" ? "ipinfo.io" : net.ipinfo;
		if (net.ipinfo === "not queried") {
			const query = el("button", "query ipinfo.io (sends this IP to ipinfo)", "ip-copy");
			query.type = "button";
			query.addEventListener("click", () => loadNetwork(host, links, ip, request, true));
			ipinfoState = query;
		}
		host.replaceChildren(
			facts([
				["reverse dns", net.reverseDns.join(", ") || net.hostname || "none"],
				["asn / org source", ipinfoState],
				["asn", net.asn],
				["organization", net.org],
				["ipinfo location", [netPlace, net.postal].filter(Boolean).join(" ")],
				["timezone", net.timezone],
				["flags", flags],
			]),
		);
		links.replaceChildren(toolLinks(ip, net));
	}

	async function loadNetwork(host: HTMLElement, links: HTMLElement, ip: string, request: number, ipinfo = false) {
		host.replaceChildren(el("p", ipinfo ? "querying ipinfo.io…" : "looking up reverse dns…", "vis-empty"));
		try {
			const response = await fetch(`/api/visits?view=network&ip=${encodeURIComponent(ip)}${ipinfo ? "&ipinfo=1" : ""}`, { cache: "no-store" });
			if (request !== panelRequest) return;
			if (!response.ok) throw new Error(String(response.status));
			renderNetwork(host, links, ip, (await response.json()).network, request);
		} catch (error) {
			if (request === panelRequest) host.replaceChildren(el("p", `network lookup failed (${(error as Error).message})`, "vis-empty"));
		}
	}

	function renderIp(detail: IpDetail, request: number) {
		const t = detail.totals;
		const copy = el("button", "copy", "ip-copy");
		copy.type = "button";
		copy.addEventListener("click", () => {
			navigator.clipboard?.writeText(detail.ip).then(() => (copy.textContent = "copied"));
		});
		const titleRow = el("div", undefined, "ip-title-row");
		titleRow.append(el("span", detail.ip, "ip-addr"), copy);

		const PATHS_SHOWN = 10;
		const pathList = el("ol", undefined, "vis-list");
		const maxPath = Math.max(1, ...detail.paths.map((p) => p.views));
		detail.paths.forEach((p, index) => {
			const li = el("li");
			li.style.setProperty("--share", `${(p.views / maxPath) * 100}%`);
			li.append(el("span", p.path, "vis-name"), el("span", n(p.views), "vis-count"));
			li.hidden = index >= PATHS_SHOWN;
			pathList.append(li);
		});
		const pathNodes: Node[] = [pathList];
		if (detail.paths.length > PATHS_SHOWN) {
			const toggle = el("button", `show all ${n(detail.paths.length)} pages`, "pager-btn");
			toggle.type = "button";
			toggle.style.marginTop = "6px";
			toggle.addEventListener("click", () => {
				const expand = toggle.dataset.expanded !== "1";
				toggle.dataset.expanded = expand ? "1" : "";
				pathList.querySelectorAll("li").forEach((li, index) => (li.hidden = !expand && index >= PATHS_SHOWN));
				toggle.textContent = expand ? `show top ${PATHS_SHOWN}` : `show all ${n(detail.paths.length)} pages`;
			});
			pathNodes.push(toggle);
		}

		const table = el("table", undefined, "ip-history");
		const head = el("thead");
		const hr = el("tr");
		for (const h of ["time", "page", "location", "referrer", "views", "source"]) hr.append(el("th", h));
		head.append(hr);
		const body = el("tbody");
		table.append(head, body);
		const tableWrap = el("div", undefined, "vis-table-wrap");
		tableWrap.append(table);
		const empty = el("p", "none yet", "vis-empty");
		empty.hidden = true;
		const pagerTop = el("div", undefined, "pager-host");
		const pagerBottom = el("div", undefined, "pager-host");

		const network = el("div");
		const links = el("div");
		links.append(toolLinks(detail.ip, null));
		const fingerprintHost = el("div", undefined, "fp-list");
		if (detail.fingerprints.length) {
			detail.fingerprints.forEach((snapshot, index) => fingerprintHost.append(fingerprintSnapshot(snapshot, index === 0)));
		} else {
			fingerprintHost.append(el("p", "none captured yet", "vis-empty"));
		}

		panelBody.replaceChildren(
			titleRow,
			section(
				"activity",
				facts([
					["views", `${n(t.views)}${t.imported ? ` (${n(t.imported)} from cf logs)` : ""}`],
					["visits", n(t.visits)],
					["rows", n(t.rows)],
					["active days", n(t.days)],
					["first seen", t.first ? when(t.first) : null],
					["last seen", t.last ? when(t.last) : null],
					["↵", t.visits ? "marks a session entry page" : null],
					["seen from", detail.places.map((p) => `${place(p)} (${n(p.views)})`).join("; ")],
				]),
			),
			section("browser fingerprints", fingerprintHost),
			section("network", network),
			section("pages", ...pathNodes),
			section("history", pagerTop, empty, tableWrap, pagerBottom),
			section("lookup", links),
		);

		pagedHistory({
			body,
			empty,
			hosts: [pagerTop, pagerBottom],
			query: (page, size) => `/api/visits?view=history&ip=${encodeURIComponent(detail.ip)}&page=${page}&size=${size}`,
			row: ipHistoryRow,
			alive: () => request === panelRequest,
		}).reload(1);
		loadNetwork(network, links, detail.ip, request);
	}

	async function openIp(ip: string, trigger: HTMLElement | null = null) {
		const request = ++panelRequest;
		if (!panel.classList.contains("open")) lastFocus = trigger ?? (document.activeElement as HTMLElement | null);
		$("ip-panel-title").textContent = ip;
		panelBody.replaceChildren(el("p", "loading…", "vis-empty"));
		panelBody.scrollTop = 0;
		panel.classList.add("open");
		panel.setAttribute("aria-hidden", "false");
		backdrop.hidden = false;
		document.body.classList.add("ip-panel-open");
		$("ip-close").focus({ preventScroll: true });
		history.replaceState(null, "", `#ip=${encodeURIComponent(ip)}`);
		const response = await fetch(`/api/visits?ip=${encodeURIComponent(ip)}`, { cache: "no-store" });
		if (request !== panelRequest) return;
		if (!response.ok) {
			panelBody.replaceChildren(el("p", `could not load ${ip} (${response.status})`, "vis-empty"));
			return;
		}
		renderIp(await response.json(), request);
	}

	function closeIp() {
		if (!panel.classList.contains("open")) return;
		panelRequest++;
		panel.classList.remove("open");
		panel.setAttribute("aria-hidden", "true");
		backdrop.hidden = true;
		document.body.classList.remove("ip-panel-open");
		history.replaceState(null, "", location.pathname + location.search);
		// The table may have re-rendered while the panel was open; fall back to the same IP's new button.
		const ip = lastFocus?.dataset.ip;
		const target = lastFocus?.isConnected ? lastFocus : ip ? document.querySelector<HTMLElement>(`.ip-link[data-ip="${CSS.escape(ip)}"]`) : null;
		target?.focus({ preventScroll: true });
	}

	document.addEventListener("click", (event) => {
		const button = (event.target as HTMLElement).closest<HTMLElement>(".ip-link");
		if (button?.dataset.ip) openIp(button.dataset.ip, button);
	});
	$("ip-close").addEventListener("click", closeIp);
	backdrop.addEventListener("click", closeIp);
	// While the panel is open the site-wide arrow/hjkl navigation must not react.
	// Keys aimed inside the panel still reach their target (e.g. the page-jump
	// input), then stop at the panel; keys aimed elsewhere stop at capture.
	document.addEventListener(
		"keydown",
		(event) => {
			if (!panel.classList.contains("open")) return;
			if (event.key === "Escape") {
				event.preventDefault();
				event.stopPropagation();
				closeIp();
				return;
			}
			if (!panel.contains(event.target as Node)) event.stopPropagation();
		},
		true,
	);
	panel.addEventListener("keydown", (event) => event.stopPropagation());

	async function load(range: string) {
		currentRange = range;
		recent.reload(1);
		const summary = $("vis-summary");
		summary.textContent = "loading…";
		const response = await fetch(`/api/visits?range=${encodeURIComponent(range)}`, { cache: "no-store" });
		if (!response.ok) {
			summary.textContent = `could not load visits (${response.status})`;
			return;
		}
		const data: Summary & { since: number } = await response.json();
		const t = data.totals;
		const since = t.first ? ` · first ${new Date(t.first * 1000).toISOString().slice(0, 10)}` : "";
		summary.textContent = `${n(t.visits)} visits · ${n(t.views)} views · ${n(t.ips)} IPs · ${n(t.countries)} countries${since}${t.imported ? ` · ${n(t.imported)} views imported from Cloudflare logs` : ""}`;
		renderMap(data.points);
		renderDaily(fillDays(data.daily, data.since, t.first));
		renderList("vis-countries", data.countries, (row) => countryName(row.country));
		renderList("vis-cities", data.cities, place);
		renderIps(data.ips);
		renderList("vis-paths", data.paths, (row) => row.path);
		renderList("vis-referrers", data.referrers, (row) => row.referrer);
	}

	const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-range]"));
	for (const button of buttons) {
		button.addEventListener("click", () => {
			buttons.forEach((b) => b.classList.toggle("active", b === button));
			load(button.dataset.range!);
		});
	}
	load("30d");
	const initialIp = new URLSearchParams(location.hash.slice(1)).get("ip");
	if (initialIp) openIp(initialIp);
</script>

