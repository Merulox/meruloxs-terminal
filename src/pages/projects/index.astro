---
import Layout from "../../layouts/Layout.astro";
import { archiveProjects, moneySchemes } from "../../data/projects";

const archiveId = (name: string) =>
	name
		.normalize("NFKD")
		.replace(/[\u0300-\u036f]/g, "")
		.toLowerCase()
		.replace(/[^a-z0-9]+/g, "-")
		.replace(/^-+|-+$/g, "")
		.slice(0, 80);

const archiveDescriptionContext = [
	...archiveProjects.map((project) => ({
		kind: "project" as const,
		id: archiveId(project.name),
		name: project.name,
		sourceDescription: project.archiveDescription,
		description: project.description,
		role: project.role,
		impact: project.impact,
		present: project.present,
		vision: project.vision,
		frontier: project.frontier,
	})),
	...moneySchemes.map((scheme) => ({
		kind: "scheme" as const,
		id: archiveId(scheme.name),
		name: scheme.name,
		sourceDescription: scheme.description,
		currentState: scheme.currentState,
		decision: scheme.decision,
		bottleneck: scheme.bottleneck,
		history: scheme.history
			.map(
				(entry) =>
					`${entry.date} [${entry.state}] Attempt: ${entry.attemptedModel} Did: ${entry.work} Result: ${entry.result}`,
			)
			.join("\n"),
	})),
];
const archiveNamesByKey = new Map<string, string>();
for (const item of archiveDescriptionContext) {
	const key = `${item.kind}:${item.id}`;
	const existingName = archiveNamesByKey.get(key);
	if (!item.id || existingName) {
		throw new Error(
			`Archive item collision: ${existingName ?? "(empty slug)"} and ${item.name} resolve to "${key}"`,
		);
	}
	archiveNamesByKey.set(key, item.name);
}
const serializedArchiveDescriptionContext = JSON.stringify(
	archiveDescriptionContext,
).replace(/</g, "\\u003c");
---

<Layout
	title="archive | MERULOX"
	description="Projects and money-making experiments built, tested, pursued, paused, and rejected by Merulox."
>
	<header class="archive-intro">
		<h1>Archive</h1>
		<p>
			The projects are what I built, adapted, or tested. The money schemes are the honest ledger:
			what I tried, what I actually did, how it went, where it stands, and what
			stopped it.
		</p>
		<div class="archive-index" role="group" aria-label="Archive view">
			<button
				type="button"
				class="archive-switch"
				data-archive-target="projects"
				aria-pressed="true"
			>
				<span class="archive-switch-marker" aria-hidden="true">›</span>
				<span>Projects</span>
				<span class="archive-count">{archiveProjects.length}</span>
			</button>
			<button
				type="button"
				class="archive-switch"
				data-archive-target="money-schemes"
				aria-pressed="false"
			>
				<span class="archive-switch-marker" aria-hidden="true">›</span>
				<span>Money schemes</span>
				<span class="archive-count">{moneySchemes.length}</span>
			</button>
		</div>
	</header>

	<section
		id="projects"
		class="section archive-section"
		aria-labelledby="projects-heading"
		data-archive-panel
	>
		<h2 id="projects-heading" class="eyebrow">Projects</h2>
		<p class="archive-section-note">
			Systems, products, prototypes, and retired builds. A status describes what is
			true now—not how ambitious the original idea was.
		</p>

		<div class="proj-list">
			{
				archiveProjects.map((project, index) => {
					const isOpen = index === 0;
					const bodyId = `project-body-${index}`;
					const id = archiveId(project.name);
					const descriptionId = `project-description-${id}`;

					return (
						<article
							class={`proj${isOpen ? " open" : ""}`}
							data-project-id={id}
							data-archive-kind="project"
							data-archive-id={id}
						>
							<button
								class="proj-head list-item"
								aria-expanded={isOpen ? "true" : "false"}
								aria-controls={bodyId}
							>
								<span class="proj-caret" aria-hidden="true">›</span>
								<span class="proj-name">{project.name}</span>
								<span class={`proj-state ${project.state}`}>{project.state}</span>
								<span class="proj-date">{project.date}</span>
							</button>
							<div id={bodyId} class="proj-body" hidden={!isOpen}>
								<p id={descriptionId} class="project-description" data-archive-description>
									{project.archiveDescription}
								</p>

								<div class="living-thesis">
									<section class="thesis-block">
										<h3>Present</h3>
										<p>{project.present}</p>
									</section>
									<section class="thesis-block">
										<h3>Vision</h3>
										<p>{project.vision}</p>
									</section>
									<section class="thesis-block">
										<h3>Frontier</h3>
										<p>{project.frontier}</p>
									</section>
									<section class="thesis-block project-receipts">
										<h3>Receipts</h3>
										<ul class="archive-proof">
											{
												project.proof.map((item) => (
													<li>
														{item.href ? (
															<a href={item.href} target="_blank" rel="noreferrer">
																{item.label} ↗
															</a>
														) : item.label}
													</li>
												))
											}
										</ul>
									</section>
								</div>

								<ul class="tag-list archive-tags" aria-label={`${project.name} stack`}>
									{project.tags.map((tag) => <li>{tag}</li>)}
								</ul>
							</div>
						</article>
					);
				})
			}
		</div>
	</section>

	<section
		id="money-schemes"
		class="section archive-section"
		aria-labelledby="money-schemes-heading"
		data-archive-panel
	>
		<h2 id="money-schemes-heading" class="eyebrow">Money schemes</h2>
		<p class="archive-section-note">
			Commercial bets, market probes, trading ideas, and internet-money experiments.
			Internal test credits, paper returns, replies, and shipped code are not counted
			as revenue.
		</p>

		<div class="proj-list scheme-list">
			{
				moneySchemes.map((scheme, index) => {
					const bodyId = `scheme-body-${index}`;
					const id = archiveId(scheme.name);
					const descriptionId = `scheme-description-${id}`;

					return (
						<article
							class="proj scheme"
							data-scheme-id={id}
							data-archive-kind="scheme"
							data-archive-id={id}
						>
							<button
								class="proj-head list-item"
								aria-expanded="false"
								aria-controls={bodyId}
							>
								<span class="proj-caret" aria-hidden="true">›</span>
								<span class="proj-name">{scheme.name}</span>
								<span class={`proj-state ${scheme.state}`}>{scheme.state}</span>
								<span class="proj-date">{scheme.date}</span>
							</button>
							<div id={bodyId} class="proj-body" hidden>
								<dl class="archive-fields scheme-summary">
									<div class="archive-field">
										<dt>Model</dt>
										<dd id={descriptionId} class="scheme-description" data-archive-description>
											{scheme.description}
										</dd>
									</div>
									<div class="archive-field">
										<dt>Now</dt>
										<dd>{scheme.currentState}</dd>
									</div>
									<div class="archive-field">
										<dt>Decision</dt>
										<dd>
											<span class={`scheme-decision ${scheme.decision}`}>
												{scheme.decision}
											</span>
										</dd>
									</div>
									<div class="archive-field">
										<dt>Wall</dt>
										<dd>{scheme.bottleneck}</dd>
									</div>
								</dl>

								<ol class="scheme-history" aria-label={`${scheme.name} attempt history`}>
									{
										scheme.history.map((entry) => (
											<li class="scheme-history-item">
												<div class="scheme-history-head">
													<time datetime={entry.date}>{entry.date}</time>
													<span class={`proj-state ${entry.state}`}>{entry.state}</span>
												</div>
												<dl class="scheme-history-fields">
													<div class="scheme-history-field">
														<dt>Attempt</dt>
														<dd>{entry.attemptedModel}</dd>
													</div>
													<div class="scheme-history-field">
														<dt>Did</dt>
														<dd>{entry.work}</dd>
													</div>
													<div class="scheme-history-field">
														<dt>Result</dt>
														<dd>{entry.result}</dd>
													</div>
													<div class="scheme-history-field">
														<dt>Evidence</dt>
														<dd>
															<ul class="archive-proof">
																{
																	entry.proof.map((item) => (
																		<li>
																			{item.href ? (
																				<a href={item.href} target="_blank" rel="noreferrer">
																					{item.label} ↗
																				</a>
																			) : item.label}
																		</li>
																	))
																}
															</ul>
														</dd>
													</div>
												</dl>
											</li>
										))
									}
								</ol>

								<ul class="tag-list archive-tags" aria-label={`${scheme.name} tags`}>
									{scheme.tags.map((tag) => <li>{tag}</li>)}
								</ul>
							</div>
						</article>
					);
				})
			}
		</div>
	</section>

	<script
		is:inline
		id="archive-description-context"
		type="application/json"
		set:html={serializedArchiveDescriptionContext}
	></script>

	<style is:global>
		.project-description-edit {
			margin: -10px 0 18px;
		}

		.project-description-edit > button,
		.project-description-actions button {
			appearance: none;
			border: 1px solid var(--faint);
			border-radius: 2px;
			background: transparent;
			color: var(--muted);
			cursor: pointer;
			font: inherit;
			font-size: 12px;
			padding: 4px 8px;
		}

		.project-description-edit > button:hover,
		.project-description-edit > button:focus-visible,
		.project-description-actions button:hover,
		.project-description-actions button:focus-visible {
			border-color: var(--accent);
			color: var(--text);
			outline: none;
		}

		.project-description-actions button:disabled {
			cursor: wait;
			opacity: 0.5;
		}

		.project-description-editor {
			display: grid;
			gap: 10px;
			margin: 0 0 22px;
			padding: 14px;
			border: 1px solid var(--line);
		}

		.project-description-editor[hidden] {
			display: none;
		}

		.project-description-editor label {
			display: grid;
			gap: 4px;
			color: var(--muted);
			font-size: 12px;
		}

		.project-description-editor textarea,
		.project-description-editor input {
			width: 100%;
			border: 1px solid var(--faint);
			border-radius: 2px;
			background: var(--bg);
			color: var(--text);
			font: inherit;
			font-size: 13px;
			padding: 7px 8px;
		}

		.project-description-editor textarea:focus,
		.project-description-editor input:focus {
			border-color: var(--accent);
			outline: none;
		}

		.proj-body .project-description-preview {
			min-height: 2.5em;
			margin: 0;
			padding-left: 9px;
			border-left: 2px solid var(--accent);
			color: var(--text);
			white-space: pre-wrap;
		}

		.project-description-actions {
			display: flex;
			flex-wrap: wrap;
			gap: 7px;
		}

		.proj-body .project-description-status {
			min-height: 1.5em;
			margin: 0;
			color: var(--muted);
			font-size: 12px;
		}

		.proj-body .project-description-status[data-error="true"] {
			color: #d78080;
		}
		.archive-candidate {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: 7px;
			margin: -10px 0 18px;
			padding: 8px;
			border-left: 2px solid var(--accent);
			color: var(--muted);
			font-size: 12px;
		}

		.archive-candidate details,
		.archive-candidate label {
			flex-basis: 100%;
		}

		.archive-candidate pre {
			margin: 7px 0 0;
			white-space: pre-wrap;
			overflow-wrap: anywhere;
	}

		.archive-candidate[hidden] {
			display: none;
		}

		.archive-candidate button {
			appearance: none;
			border: 1px solid var(--faint);
			border-radius: 2px;
			background: transparent;
			color: var(--muted);
			cursor: pointer;
			font: inherit;
			padding: 4px 8px;
		}
	</style>

	<script>
		type ArchiveKind = "project" | "scheme";
		type ArchiveDescriptionRecord = {
			kind: ArchiveKind;
			id: string;
			name: string;
			sourceDescription: string;
			description?: string;
			role?: string;
			impact?: string;
			present?: string;
			vision?: string;
			frontier?: string;
			currentState?: string;
			decision?: string;
			bottleneck?: string;
			history?: string;
		};
		type Candidate = {
			description: string;
			version?: string | null;
			evidence?: string;
			updatedAt?: string | null;
		};
		type EditorElements = {
			editButton: HTMLButtonElement;
			panel: HTMLElement;
			textarea: HTMLTextAreaElement;
			instruction: HTMLInputElement;
			preview: HTMLElement;
			status: HTMLElement;
			candidate: HTMLElement;
			evidence: HTMLElement;
			acknowledgment: HTMLInputElement;
			saveButton: HTMLButtonElement;
			busy: boolean;
			actionButtons: HTMLButtonElement[];
		};

		const itemKey = (kind: ArchiveKind, id: string) => `${kind}:${id}`;
		const contextElement = document.getElementById("archive-description-context");
		let archiveRecords: ArchiveDescriptionRecord[] = [];
		try {
			const parsed = JSON.parse(contextElement?.textContent ?? "[]");
			if (Array.isArray(parsed)) archiveRecords = parsed;
		} catch {
			archiveRecords = [];
		}

		const activeDescriptions = new Map(
			archiveRecords.map((record) => [
				itemKey(record.kind, record.id),
				record.sourceDescription,
			]),
		);
		const editors = new Map<string, EditorElements>();

		const apiRequest = async (
			method: "GET" | "POST" | "PUT" | "DELETE" | "PATCH",
			body?: Record<string, unknown>,
		) => {
			const response = await fetch("/api/project-descriptions", {
				method,
				cache: "no-store",
				credentials: "same-origin",
				headers: body ? { "Content-Type": "application/json" } : undefined,
				body: body ? JSON.stringify(body) : undefined,
			});
			let payload: Record<string, any> = {};
			try {
				payload = await response.json();
			} catch {
				// The status below remains useful when an intermediary returns non-JSON.
			}
			if (!response.ok) {
				throw new Error(
					typeof payload.error === "string"
						? payload.error
						: `Request failed (${response.status})`,
				);
			}
			return payload;
		};

		const descriptionElement = (record: ArchiveDescriptionRecord) =>
			document.querySelector<HTMLElement>(
				`[data-archive-kind="${record.kind}"][data-archive-id="${CSS.escape(record.id)}"] [data-archive-description]`,
			);

		const applyDescription = (
			record: ArchiveDescriptionRecord,
			description: string,
		) => {
			const output = descriptionElement(record);
			if (output) output.textContent = description;
			const key = itemKey(record.kind, record.id);
			activeDescriptions.set(key, description);
			const editor = editors.get(key);
			if (editor?.panel.hidden) {
				editor.textarea.value = description;
				editor.preview.textContent = description;
			}
		};

		const makeButton = (label: string) => {
			const button = document.createElement("button");
			button.type = "button";
			button.textContent = label;
			return button;
		};

		const syncSaveGate = (editor: EditorElements) => {
			const candidatePending = !editor.candidate.hidden;
			editor.saveButton.disabled =
				editor.busy || (candidatePending && !editor.acknowledgment.checked);
		};

		const setEditorBusy = (
			editor: EditorElements,
			busy: boolean,
			message = "",
		) => {
			editor.busy = busy;
			editor.textarea.disabled = busy;
			editor.instruction.disabled = busy;
			editor.acknowledgment.disabled = busy;
			editor.editButton.disabled = busy;
			editor.actionButtons.forEach((button) => {
				button.disabled = busy;
			});
			syncSaveGate(editor);
			editor.status.dataset.error = "false";
			editor.status.textContent = message;
		};

		const reportEditorError = (editor: EditorElements, caught: unknown) => {
			setEditorBusy(editor, false);
			editor.status.dataset.error = "true";
			editor.status.textContent =
				caught instanceof Error ? caught.message : "The request failed.";
		};

		const candidateFor = (
			payload: Record<string, any>,
			record: ArchiveDescriptionRecord,
		): Candidate | undefined => payload.candidates?.[record.kind]?.[record.id];

		const syncCandidate = (
			payload: Record<string, any>,
			record: ArchiveDescriptionRecord,
			editor: EditorElements,
			useButton: HTMLButtonElement,
		) => {
			const scheduled = candidateFor(payload, record);
			if (
				scheduled &&
				typeof scheduled.description === "string" &&
				scheduled.description.trim() &&
				typeof scheduled.version === "string"
			) {
				useButton.dataset.description = scheduled.description;
				useButton.dataset.version = scheduled.version;
				editor.evidence.textContent =
					typeof scheduled.evidence === "string"
						? scheduled.evidence
						: "No repository evidence supplied.";
				editor.acknowledgment.checked = false;
				editor.candidate.hidden = false;
				syncSaveGate(editor);
				return true;
			}
			delete useButton.dataset.description;
			delete useButton.dataset.version;
			editor.evidence.textContent = "";
			editor.acknowledgment.checked = false;
			editor.candidate.hidden = true;
			syncSaveGate(editor);
			return false;
		};

		if (window.location.hostname === "dev.merulox.com") {
			archiveRecords.forEach((record) => {
				const output = descriptionElement(record);
				if (!output) return;
				const key = itemKey(record.kind, record.id);

				const editContainer = document.createElement("div");
				editContainer.className = "project-description-edit";
				const editButton = makeButton("edit description");
				const panelId = `archive-description-editor-${record.kind}-${record.id}`;
				editButton.setAttribute("aria-controls", panelId);
				editButton.setAttribute("aria-expanded", "false");
				editContainer.append(editButton);

				const candidate = document.createElement("div");
				candidate.className = "archive-candidate";
				candidate.hidden = true;
				const candidateMessage = document.createElement("span");
				candidateMessage.textContent = "Scheduled review draft is ready.";
				const evidenceDetails = document.createElement("details");
				const evidenceSummary = document.createElement("summary");
				evidenceSummary.textContent = "Repository evidence (unverified)";
				const candidateEvidence = document.createElement("pre");
				candidateEvidence.textContent = "";
				evidenceDetails.append(evidenceSummary, candidateEvidence);
				const acknowledgmentLabel = document.createElement("label");
				const acknowledgment = document.createElement("input");
				acknowledgment.type = "checkbox";
				acknowledgmentLabel.append(
					acknowledgment,
					" I acknowledge that the repository evidence is unverified.",
				);
				const useCandidateButton = makeButton("Use scheduled draft");
				const dismissCandidateButton = makeButton("Dismiss draft");
				candidate.append(
					candidateMessage,
					evidenceDetails,
					acknowledgmentLabel,
					useCandidateButton,
					dismissCandidateButton,
				);

				const panel = document.createElement("section");
				panel.className = "project-description-editor";
				panel.id = panelId;
				panel.hidden = true;
				panel.setAttribute("aria-label", `Edit ${record.name} description`);

				const descriptionLabel = document.createElement("label");
				descriptionLabel.textContent = "Description";
				const textarea = document.createElement("textarea");
				textarea.rows = 6;
				textarea.maxLength = 2000;
				textarea.value = record.sourceDescription;
				textarea.setAttribute("aria-label", `${record.name} description`);
				descriptionLabel.append(textarea);

				const instructionLabel = document.createElement("label");
				instructionLabel.textContent = "AI instruction (optional)";
				const instruction = document.createElement("input");
				instruction.type = "text";
				instruction.maxLength = 1000;
				instruction.placeholder = "e.g. make it clearer and more concise";
				instruction.setAttribute("aria-label", `${record.name} AI instruction`);
				instructionLabel.append(instruction);

				const previewLabel = document.createElement("span");
				previewLabel.textContent = "Preview (not saved)";
				const preview = document.createElement("p");
				preview.className = "project-description-preview";
				preview.textContent = record.sourceDescription;
				preview.setAttribute("aria-label", `${record.name} unsaved preview`);

				const actions = document.createElement("div");
				actions.className = "project-description-actions";
				const generateButton = makeButton("Generate Preview");
				const saveButton = makeButton("Save");
				const resetButton = makeButton("Reset to source");
				const cancelButton = makeButton("Cancel");
				actions.append(generateButton, saveButton, resetButton, cancelButton);

				const status = document.createElement("p");
				status.className = "project-description-status";
				status.setAttribute("role", "status");
				status.setAttribute("aria-live", "polite");

				panel.append(
					descriptionLabel,
					instructionLabel,
					previewLabel,
					preview,
					actions,
					status,
				);
				output.insertAdjacentElement("afterend", editContainer);
				editContainer.insertAdjacentElement("afterend", candidate);
				candidate.insertAdjacentElement("afterend", panel);

				const editor: EditorElements = {
					editButton,
					panel,
					textarea,
					instruction,
					preview,
					status,
					candidate,
					evidence: candidateEvidence,
					acknowledgment,
					saveButton,
					busy: false,
					actionButtons: [
						generateButton,
						saveButton,
						resetButton,
						cancelButton,
						useCandidateButton,
						dismissCandidateButton,
					],
				};
				editors.set(key, editor);

				acknowledgment.addEventListener("change", () => {
					syncSaveGate(editor);
				});

				editButton.addEventListener("click", () => {
					const opening = panel.hidden;
					panel.hidden = !opening;
					editButton.setAttribute("aria-expanded", opening ? "true" : "false");
					const current = activeDescriptions.get(key) ?? record.sourceDescription;
					if (opening) {
						textarea.value = current;
						preview.textContent = current;
						status.textContent = "";
						status.dataset.error = "false";
						textarea.focus();
					} else {
						output.textContent = current;
						textarea.value = current;
						preview.textContent = current;
						instruction.value = "";
						status.textContent = "";
					}
				});

				textarea.addEventListener("input", () => {
					preview.textContent = textarea.value;
					output.textContent = textarea.value;
					status.dataset.error = "false";
					status.textContent = "Local preview only — not saved.";
				});

				generateButton.addEventListener("click", async () => {
					setEditorBusy(editor, true, "Generating preview…");
					try {
						const payload = await apiRequest("POST", {
							...record,
							draft: textarea.value,
							instruction: instruction.value,
						});
						if (typeof payload.preview !== "string" || !payload.preview.trim()) {
							throw new Error("AI returned an invalid preview.");
						}
						textarea.value = payload.preview;
						preview.textContent = payload.preview;
						output.textContent = payload.preview;
						setEditorBusy(editor, false, "AI preview ready — not saved.");
					} catch (caught) {
						reportEditorError(editor, caught);
					}
				});

				saveButton.addEventListener("click", async () => {
					if (!candidate.hidden && !acknowledgment.checked) return;
					setEditorBusy(editor, true, "Saving…");
					try {
						const candidateVersion = useCandidateButton.dataset.version;
						const payload = await apiRequest("PUT", {
							kind: record.kind,
							id: record.id,
							description: textarea.value,
							clearCandidate: Boolean(candidateVersion),
							candidateVersion,
						});
						if (typeof payload.description !== "string") {
							throw new Error("Save returned an invalid description.");
						}
						applyDescription(record, payload.description);
						textarea.value = payload.description;
						preview.textContent = payload.description;
						let saveMessage = "Saved. Public and dev pages now use this override.";
						try {
							const latest = await apiRequest("GET");
							if (syncCandidate(latest, record, editor, useCandidateButton)) {
								saveMessage =
									"Saved. A newer or uncleared scheduled draft is ready for review.";
							}
						} catch {
							if (candidateVersion) {
								acknowledgment.checked = false;
								candidate.hidden = false;
								syncSaveGate(editor);
							}
							saveMessage =
								"Saved. Refresh the page to confirm scheduled-draft status.";
						}
						setEditorBusy(editor, false, saveMessage);
					} catch (caught) {
						reportEditorError(editor, caught);
					}
				});

				resetButton.addEventListener("click", async () => {
					setEditorBusy(editor, true, "Resetting…");
					try {
						await apiRequest("DELETE", { kind: record.kind, id: record.id });
						applyDescription(record, record.sourceDescription);
						textarea.value = record.sourceDescription;
						preview.textContent = record.sourceDescription;
						setEditorBusy(editor, false, "Override removed; source description restored.");
					} catch (caught) {
						reportEditorError(editor, caught);
					}
				});

				cancelButton.addEventListener("click", () => {
					const current = activeDescriptions.get(key) ?? record.sourceDescription;
					output.textContent = current;
					textarea.value = current;
					preview.textContent = current;
					instruction.value = "";
					status.textContent = "";
					panel.hidden = true;
					editButton.setAttribute("aria-expanded", "false");
					editButton.focus();
				});

				useCandidateButton.addEventListener("click", () => {
					const scheduled = useCandidateButton.dataset.description;
					if (!scheduled) return;
					panel.hidden = false;
					editButton.setAttribute("aria-expanded", "true");
					textarea.value = scheduled;
					preview.textContent = scheduled;
					status.dataset.error = "false";
					status.textContent = "Scheduled draft loaded — review and Save to publish.";
					textarea.focus();
				});

				dismissCandidateButton.addEventListener("click", async () => {
					setEditorBusy(editor, true, "Dismissing scheduled draft…");
					try {
						const version = useCandidateButton.dataset.version;
						if (!version) throw new Error("Scheduled draft version is unavailable.");
						await apiRequest("PATCH", {
							kind: record.kind,
							id: record.id,
							action: "dismiss",
							version,
						});
						try {
							const latest = await apiRequest("GET");
							const hasCandidate = syncCandidate(
								latest,
								record,
								editor,
								useCandidateButton,
							);
							setEditorBusy(
								editor,
								false,
								hasCandidate
									? "Draft dismissed; a newer scheduled draft is ready."
									: "Scheduled draft dismissed.",
							);
						} catch {
							candidate.hidden = false;
							setEditorBusy(
								editor,
								false,
								"Draft dismissed. Refresh the page to confirm scheduled-draft status.",
							);
						}
					} catch (caught) {
						reportEditorError(editor, caught);
					}
				});
			});
		}

		editors.forEach((editor) => {
			setEditorBusy(editor, true, "Loading saved description…");
		});

		void apiRequest("GET")
			.then((payload) => {
				archiveRecords.forEach((record) => {
					const overrides =
						record.kind === "project" ? payload.overrides : payload.schemeOverrides;
					const override = overrides?.[record.id];
					if (
						override &&
						typeof override.description === "string" &&
						override.description.trim()
					) {
						applyDescription(record, override.description);
					}
					const editor = editors.get(itemKey(record.kind, record.id));
					if (editor) {
						const useButton = editor.candidate.querySelector<HTMLButtonElement>(
							"button:first-of-type",
						);
						if (useButton) syncCandidate(payload, record, editor, useButton);
					}
				});
			})
			.catch(() => {
				// Static source descriptions remain usable when overrides are unavailable.
			})
			.finally(() => {
				editors.forEach((editor) => {
					setEditorBusy(editor, false);
				});
			});

		const archiveSwitches = Array.from(
			document.querySelectorAll<HTMLButtonElement>("[data-archive-target]"),
		);
		const archivePanels = Array.from(
			document.querySelectorAll<HTMLElement>("[data-archive-panel]"),
		);

		const activateArchivePanel = (panelId: string, updateUrl = true) => {
			archiveSwitches.forEach((control) => {
				control.setAttribute(
					"aria-pressed",
					control.dataset.archiveTarget === panelId ? "true" : "false",
				);
			});
			archivePanels.forEach((panel) => {
				panel.hidden = panel.id !== panelId;
			});
			if (updateUrl) history.replaceState(null, "", `#${panelId}`);
			document.dispatchEvent(
				new CustomEvent("archive-panel-change", { detail: { panelId } }),
			);
		};

		archiveSwitches.forEach((control) => {
			control.addEventListener("keydown", (event) => event.stopPropagation());
			control.addEventListener("click", () => {
				activateArchivePanel(control.dataset.archiveTarget ?? "projects");
			});
		});

		const initialPanel =
			window.location.hash === "#money-schemes" ? "money-schemes" : "projects";
		activateArchivePanel(initialPanel, false);

		window.addEventListener("hashchange", () => {
			const panel =
				window.location.hash === "#money-schemes" ? "money-schemes" : "projects";
			activateArchivePanel(panel, false);
		});

		document.querySelectorAll<HTMLButtonElement>(".proj-head").forEach((head) => {
			const bodyId = head.getAttribute("aria-controls");
			const body = bodyId ? document.getElementById(bodyId) : null;
			if (!body) return;

			head.addEventListener("click", () => {
				const project = head.closest(".proj")!;
				const open = project.classList.toggle("open");
				head.setAttribute("aria-expanded", open ? "true" : "false");
				body.hidden = !open;
			});
		});
	</script>
</Layout>
